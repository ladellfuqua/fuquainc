---
/**
 * Site footer (§21). Midnight navy. Clean and compact.
 */
import Wordmark from './Wordmark.astro';
import LinkedInLink from './LinkedInLink.astro';

const year = 2026; // launch year per §21
---

<footer class="site-footer">
  <div class="container site-footer__inner">
    <div class="site-footer__brand">
      <Wordmark href={null} tone="light" />
      <p class="site-footer__tagline">Strategy. Growth. Impact.</p>
    </div>

    <nav class="site-footer__nav" aria-label="Footer">
      <a href="/about">About</a>
      <a href="/writing">Writing</a>
      <a href="/contact">Contact</a>
      <a href="/privacy">Privacy</a>
      <LinkedInLink label="LinkedIn" />
    </nav>
  </div>

  <div class="container site-footer__meta">
    <p>&copy; {year} Fuqua Inc.</p>
  </div>

  <div class="site-footer__wordmark-frame" aria-hidden="true">
    <span class="site-footer__wordmark">FUQUA</span>
  </div>
</footer>

<style>
  .site-footer {
    position: relative;
    isolation: isolate;
    overflow: clip;
    background: #182536;
    color: var(--on-dark-muted);
    padding-block: clamp(3rem, 2.4rem + 3vw, 4.5rem) 2rem;
  }
  .site-footer__inner,
  .site-footer__meta {
    position: relative;
    z-index: 1;
  }
  .site-footer__inner {
    display: flex;
    flex-wrap: wrap;
    align-items: flex-start;
    justify-content: space-between;
    gap: var(--space-lg);
    padding-bottom: var(--space-lg);
    border-bottom: 1px solid var(--on-dark-line);
  }
  .site-footer__tagline {
    margin-top: 0.9rem;
    color: var(--on-dark-muted);
    font-size: var(--fs-sm);
    letter-spacing: 0.02em;
  }
  .site-footer__nav {
    display: flex;
    flex-wrap: wrap;
    gap: clamp(1rem, 0.5rem + 2vw, 2.25rem);
    align-items: center;
  }
  .site-footer__nav a,
  .site-footer__nav :global(.linkedin-link) {
    color: var(--on-dark);
    font-size: var(--fs-sm);
    font-weight: var(--weight-medium);
  }
  .site-footer__nav a:hover,
  .site-footer__nav :global(.linkedin-link:hover) {
    color: #fff;
    text-decoration: none;
  }
  .site-footer__meta {
    margin-top: var(--space-md);
    font-size: var(--fs-sm);
    color: var(--on-dark-muted);
  }
  .site-footer__wordmark-frame {
    position: absolute;
    z-index: 0;
    inset: 0;
    display: flex;
    align-items: flex-end;
    justify-content: center;
    overflow: clip;
    pointer-events: none;
    user-select: none;
  }
  .site-footer__wordmark {
    display: block;
    max-inline-size: 100%;
    color: #26374d;
    font-family: var(--font-sans);
    font-size: clamp(110px, 17vw, 220px);
    font-weight: var(--weight-bold);
    letter-spacing: -0.02em;
    line-height: 0.72;
    text-align: center;
    white-space: nowrap;
    transform: translateY(18%);
  }
  @media (max-width: 40rem) {
    .site-footer__nav {
      flex-direction: column;
      align-items: flex-start;
      gap: 0.9rem;
    }
  }
</style>
