---
/** Writing landing page redesign (LAD-38). */
import BaseLayout from '../layouts/BaseLayout.astro';
import PageHeaderBand from '../components/PageHeaderBand.astro';
import PageMotion from '../components/PageMotion.astro';
import {
  articleHref,
  formatArticleDate,
  getPublishedArticles,
} from '../lib/articles';

const ENABLE_THEME_FILTERS = import.meta.env.PUBLIC_ENABLE_WRITING_THEMES === 'true';
const PAGE_SIZE = 6;

const themes = [
  {
    name: 'Work and Leadership',
    note: 'How people lead, build teams and find meaning in the work itself.',
  },
  {
    name: 'Identity and Belonging',
    note: 'Being seen and included — race, access, power, and who gets to belong.',
  },
  {
    name: 'Technology and Change',
    note: 'How technology reshapes what we do, and what it asks of us.',
  },
  {
    name: 'Culture and Opportunity',
    note: 'The forces that widen or narrow the paths available to people.',
  },
  {
    name: 'Personal Reflections',
    note: 'Shorter, more personal notes and observations from along the way.',
  },
];

const articles = await getPublishedArticles();
const [featured, ...remaining] = articles;
const themeCounts = Object.fromEntries(
  themes.map((theme) => [
    theme.name,
    articles.filter((article) => article.data.themes.includes(theme.name)).length,
  ])
);
const articleData = articles.map((article) => ({
  id: article.id,
  href: articleHref(article),
  title: article.data.title,
  deck: article.data.deck,
  publishedAt: article.data.publishedAt.toISOString(),
  date: formatArticleDate(article.data.publishedAt),
  themes: article.data.themes,
}));
const articleJson = JSON.stringify({
  articles: articleData,
  themes,
  pageSize: PAGE_SIZE,
}).replace(/</g, '\\u003c');
const collectionSchema = {
  '@context': 'https://schema.org',
  '@type': 'CollectionPage',
  name: 'Writing',
  description: 'Short articles by Ladell Fuqua on work and leadership, identity and belonging, technology and change, culture and opportunity.',
  url: new URL('/writing', Astro.site).href,
  mainEntity: {
    '@type': 'ItemList',
    itemListElement: articleData.map((article, index) => ({
      '@type': 'ListItem',
      position: index + 1,
      url: new URL(article.href, Astro.site).href,
      name: article.title,
    })),
  },
};
---

<BaseLayout
  title="Writing"
  description="Short articles by Ladell Fuqua on work and leadership, identity and belonging, technology and change, culture and opportunity."
  headerTone="dark"
>
  <script slot="head" type="application/ld+json" set:html={JSON.stringify(collectionSchema)} />

  <PageHeaderBand
    eyebrow="Writing"
    title="Short articles."
    intro="On work and leadership, identity and belonging, technology and change, culture and opportunity — and the experiences that connect them."
    variant="writing"
  />

  {
    ENABLE_THEME_FILTERS && (
      <section class="theme-index" aria-labelledby="theme-filter-label">
        <div class="container theme-index__inner">
          <p id="theme-filter-label" class="theme-index__label">Browse by theme</p>
          <div class="theme-chips" role="group" aria-labelledby="theme-filter-label">
            <button class="theme-chip" type="button" data-theme="All" aria-pressed="true">
              All <span aria-label={`${articles.length} articles`}>{articles.length}</span>
            </button>
            {themes.map((theme) => (
              <button class="theme-chip" type="button" data-theme={theme.name} aria-pressed="false">
                {theme.name}{' '}
                <span aria-label={`${themeCounts[theme.name]} articles`}>{themeCounts[theme.name]}</span>
              </button>
            ))}
          </div>
          <p class="theme-index__description" data-theme-description aria-live="polite"></p>
        </div>
      </section>
    )
  }

  <div class="writing-content" data-writing-content>
    <section class="featured-section" aria-labelledby="featured-heading" data-page-section>
      <div class="container featured-section__inner" data-page-parallax data-parallax-factor="0.032">
        {
          featured ? (
            <article class="featured page-reveal" data-featured>
              <p class="featured__kicker">Latest</p>
              <h2 id="featured-heading" class="featured__title">
                <a href={articleHref(featured)}><span>{featured.data.title}</span></a>
              </h2>
              <p class="featured__deck">{featured.data.deck}</p>
              <p class="featured__meta">
                <time datetime={featured.data.publishedAt.toISOString()}>{formatArticleDate(featured.data.publishedAt)}</time>
                <span aria-hidden="true">&middot;</span>
                <span>{featured.data.themes[0]}</span>
              </p>
            </article>
          ) : (
            <div class="writing-empty page-reveal" data-featured>
              <h2 id="featured-heading" class="visually-hidden">Writing</h2>
              <p>New writing appears here as it&rsquo;s published.</p>
            </div>
          )
        }
      </div>
    </section>

    {
      remaining.length > 0 && (
        <section class="article-index" aria-label="More writing" data-page-section>
          <div class="container" data-page-parallax data-parallax-factor="0.03">
            <ul class="article-list" role="list" data-article-list>
              {remaining.map((article, index) => (
                <li class="page-reveal" data-delay={String(Math.min(index % 4, 3))}>
                  <a href={articleHref(article)} class="article-row">
                    <time datetime={article.data.publishedAt.toISOString()}>
                      {formatArticleDate(article.data.publishedAt)}
                    </time>
                    <span class="article-row__body">
                      <span class="article-row__title"><span>{article.data.title}</span></span>
                      <span class="article-row__deck">{article.data.deck}</span>
                      <span class="article-row__theme">{article.data.themes[0]}</span>
                    </span>
                  </a>
                </li>
              ))}
            </ul>
            <button class="load-more" type="button" data-load-more hidden>Load more</button>
          </div>
        </section>
      )
    }
  </div>

  <script id="writing-data" type="application/json" set:html={articleJson} />
  <PageMotion />
</BaseLayout>

<style>
  .theme-index {
    padding-block: 1.65rem;
    background: var(--c-stone);
    border-bottom: 1px solid #cfc9bc;
  }

  .theme-index__label {
    color: var(--c-plum-deep);
    font-size: var(--fs-eyebrow);
    font-weight: var(--weight-semi);
    letter-spacing: var(--tracking-eyebrow);
    text-transform: uppercase;
  }

  .theme-chips {
    display: flex;
    flex-wrap: wrap;
    gap: 0.55rem;
    margin-top: 0.8rem;
  }

  .theme-chip {
    min-height: 2.4rem;
    padding: 0.52rem 0.8rem;
    color: var(--c-graphite);
    background: transparent;
    border: 1px solid #bcb5aa;
    border-radius: 999px;
    cursor: pointer;
    font-size: 0.78rem;
    font-weight: var(--weight-medium);
  }

  .theme-chip span {
    margin-left: 0.25rem;
    color: var(--text-muted);
  }

  .theme-chip:hover,
  .theme-chip[aria-pressed='true'] {
    color: #fff;
    background: var(--c-navy);
    border-color: var(--c-navy);
  }

  .theme-chip[aria-pressed='true'] span { color: #d5d9df; }

  .theme-index__description {
    min-height: 1.6em;
    margin-top: 0.9rem;
    color: var(--c-graphite);
    font-family: var(--font-serif);
    font-size: 1rem;
    font-style: italic;
  }

  .writing-content {
    background: var(--c-ivory);
  }

  .writing-content.is-filtering { opacity: 0; }

  .featured-section {
    position: relative;
    overflow: hidden;
    padding-block: clamp(3.5rem, 6vw, 5.25rem);
    background: var(--c-ivory);
  }

  .featured-section__inner { position: relative; }

  .featured {
    max-width: 56rem;
    padding-top: 1.15rem;
    border-top: 2px solid var(--c-navy);
  }

  .featured__kicker {
    color: var(--c-plum-deep);
    font-size: var(--fs-eyebrow);
    font-weight: var(--weight-semi);
    letter-spacing: var(--tracking-eyebrow);
    text-transform: uppercase;
  }

  .featured__title {
    max-width: 20ch;
    margin-top: 1rem;
    font-family: var(--font-serif);
    font-size: clamp(2.2rem, 1.7rem + 2.1vw, 3.5rem);
    font-weight: var(--weight-normal);
    line-height: 1.08;
  }

  .featured__title a {
    color: var(--c-navy);
  }

  .featured__title a:hover { text-decoration: none; }

  .featured__title span,
  .article-row__title span {
    background-image: linear-gradient(var(--c-plum), var(--c-plum));
    background-position: 0 100%;
    background-repeat: no-repeat;
    background-size: 0 1.5px;
  }

  .featured__title a:hover span,
  .featured__title a:focus-visible span,
  .article-row:hover .article-row__title span,
  .article-row:focus-visible .article-row__title span {
    background-size: 100% 1.5px;
  }

  .featured__deck {
    max-width: 48rem;
    margin-top: 1rem;
    color: var(--c-graphite);
    font-family: var(--font-serif);
    font-size: clamp(1.05rem, 1rem + 0.3vw, 1.2rem);
    font-style: italic;
    line-height: 1.55;
  }

  .featured__meta {
    display: flex;
    flex-wrap: wrap;
    gap: 0.55rem;
    margin-top: 1.25rem;
    color: var(--text-muted);
    font-size: var(--fs-sm);
  }

  .featured__meta span:not([aria-hidden]) { color: var(--c-plum-deep); }

  .article-index {
    position: relative;
    overflow: hidden;
    padding-block: 0 clamp(3.75rem, 6vw, 5.5rem);
    background: var(--c-ivory);
  }

  .article-list {
    list-style: none;
    margin: 0;
    padding: 0;
    border-top: 1px solid var(--line);
  }

  .article-list > li { border-bottom: 1px solid var(--line); }

  .article-row {
    display: grid;
    grid-template-columns: 7.5rem minmax(0, 1fr);
    gap: clamp(1rem, 0.5rem + 2vw, 2.5rem);
    padding-block: 1.35rem;
    color: inherit;
  }

  .article-row:hover { text-decoration: none; }

  .article-row time {
    padding-top: 0.2rem;
    color: var(--text-muted);
    font-size: var(--fs-sm);
  }

  .article-row__body,
  .article-row__title,
  .article-row__deck,
  .article-row__theme { display: block; }

  .article-row__body { min-width: 0; }

  .article-row__title {
    color: var(--c-navy);
    font-family: var(--font-serif);
    font-size: clamp(1.25rem, 1.15rem + 0.4vw, 1.5rem);
    font-weight: var(--weight-semi);
    line-height: 1.25;
  }

  .article-row__deck {
    max-width: 52ch;
    margin-top: 0.4rem;
    color: var(--c-graphite);
    font-family: var(--font-serif);
    font-style: italic;
  }

  .article-row__theme {
    margin-top: 0.65rem;
    color: var(--c-plum-deep);
    font-size: 0.7rem;
    font-weight: var(--weight-semi);
    letter-spacing: 0.12em;
    text-transform: uppercase;
  }

  .load-more {
    display: block;
    min-height: 2.8rem;
    margin: 2rem auto 0;
    padding: 0.7rem 1.3rem;
    color: var(--c-navy);
    background: transparent;
    border: 1px solid var(--c-navy);
    border-radius: 8px;
    cursor: pointer;
    font-size: var(--fs-sm);
    font-weight: var(--weight-medium);
  }

  .load-more:hover {
    color: #fff;
    background: var(--c-navy);
  }

  .writing-empty {
    max-width: 56rem;
    padding-block: 1.25rem;
    border-block: 1px solid var(--line);
    color: var(--text-muted);
  }

  @media (prefers-reduced-motion: no-preference) {
    .theme-chip {
      transition: color var(--dur-fast) var(--ease), background-color var(--dur-fast) var(--ease), border-color var(--dur-fast) var(--ease);
    }

    .writing-content {
      transition: opacity 180ms var(--ease);
    }

    .featured__title span,
    .article-row__title span {
      transition: background-size var(--dur) var(--ease);
    }

    .article-row__body {
      transition: transform var(--dur) var(--ease);
    }

    .article-row:hover .article-row__body,
    .article-row:focus-visible .article-row__body {
      transform: translateX(0.5rem);
    }
  }

  @media (max-width: 36rem) {
    .featured-section { padding-block: 3.25rem; }
    .article-row {
      grid-template-columns: 1fr;
      gap: 0.55rem;
    }
  }
</style>

<script>
      type WritingArticle = {
        id: string;
        href: string;
        title: string;
        deck: string;
        publishedAt: string;
        date: string;
        themes: string[];
      };

      type WritingData = {
        articles: WritingArticle[];
        themes: Array<{ name: string; note: string }>;
        pageSize: number;
      };

      const writingDataElement = document.getElementById('writing-data');
      const writingData = writingDataElement
        ? JSON.parse(writingDataElement.textContent || '{}') as WritingData
        : undefined;
      const writingContent = document.querySelector<HTMLElement>('[data-writing-content]');
      const writingList = document.querySelector<HTMLUListElement>('[data-article-list]');
      const writingLoadMore = document.querySelector<HTMLButtonElement>('[data-load-more]');
      const writingDescription = document.querySelector<HTMLElement>('[data-theme-description]');
      const writingMotion = window.matchMedia('(prefers-reduced-motion: no-preference)');
      let selectedWritingTheme = 'All';
      let visibleWritingRows = writingData?.pageSize || 6;

      function addMetaPart(parent: HTMLElement, value: string, accent = false) {
        if (parent.childElementCount) {
          const separator = document.createElement('span');
          separator.setAttribute('aria-hidden', 'true');
          separator.textContent = '·';
          parent.append(separator);
        }
        const part = document.createElement('span');
        part.textContent = value;
        if (accent) part.dataset.accent = 'true';
        parent.append(part);
      }

      function createFeaturedArticle(article: WritingArticle) {
        const wrapper = document.createElement('article');
        wrapper.className = 'featured page-reveal is-visible';
        wrapper.dataset.featured = '';

        const kicker = document.createElement('p');
        kicker.className = 'featured__kicker';
        kicker.textContent = 'Latest';

        const heading = document.createElement('h2');
        heading.id = 'featured-heading';
        heading.className = 'featured__title';
        const link = document.createElement('a');
        link.href = article.href;
        const title = document.createElement('span');
        title.textContent = article.title;
        link.append(title);
        heading.append(link);

        const deck = document.createElement('p');
        deck.className = 'featured__deck';
        deck.textContent = article.deck;

        const meta = document.createElement('p');
        meta.className = 'featured__meta';
        const time = document.createElement('time');
        time.dateTime = article.publishedAt;
        time.textContent = article.date;
        meta.append(time);
        addMetaPart(meta, article.themes[0] || '', true);

        wrapper.append(kicker, heading, deck, meta);
        return wrapper;
      }

      function createArticleRow(article: WritingArticle, index: number) {
        const item = document.createElement('li');
        item.className = 'page-reveal is-visible';
        item.dataset.delay = String(Math.min(index % 4, 3));
        const link = document.createElement('a');
        link.className = 'article-row';
        link.href = article.href;
        const time = document.createElement('time');
        time.dateTime = article.publishedAt;
        time.textContent = article.date;
        const body = document.createElement('span');
        body.className = 'article-row__body';
        const heading = document.createElement('span');
        heading.className = 'article-row__title';
        const headingText = document.createElement('span');
        headingText.textContent = article.title;
        heading.append(headingText);
        const deck = document.createElement('span');
        deck.className = 'article-row__deck';
        deck.textContent = article.deck;
        const theme = document.createElement('span');
        theme.className = 'article-row__theme';
        theme.textContent = article.themes[0] || '';
        body.append(heading, deck, theme);
        link.append(time, body);
        item.append(link);
        return item;
      }

      function writingSelection() {
        if (!writingData) return [];
        return selectedWritingTheme === 'All'
          ? writingData.articles
          : writingData.articles.filter((article) => article.themes.includes(selectedWritingTheme));
      }

      function syncLoadMore(rows: HTMLLIElement[]) {
        rows.forEach((row, index) => {
          row.hidden = index >= visibleWritingRows;
        });
        if (writingLoadMore) writingLoadMore.hidden = rows.length <= visibleWritingRows;
      }

      function renderWritingSelection() {
        if (!writingData) return;
        const writingFeature = document.querySelector<HTMLElement>('[data-featured]');
        if (!writingFeature) return;
        const selected = writingSelection();
        const featureParent = writingFeature.parentElement;
        if (!featureParent) return;

        if (selected.length) {
          const nextFeature = createFeaturedArticle(selected[0]);
          featureParent.replaceChildren(nextFeature);
        } else {
          const empty = document.createElement('div');
          empty.className = 'writing-empty page-reveal is-visible';
          empty.dataset.featured = '';
          const heading = document.createElement('h2');
          heading.id = 'featured-heading';
          heading.className = 'visually-hidden';
          heading.textContent = 'Writing';
          const message = document.createElement('p');
          message.textContent = "New writing appears here as it's published.";
          empty.append(heading, message);
          featureParent.replaceChildren(empty);
        }

        if (writingList) {
          const rows = selected.slice(1).map(createArticleRow);
          writingList.replaceChildren(...rows);
          syncLoadMore(rows);
        }

        window.dispatchEvent(new Event('page:content-updated'));
      }

      function updateThemeDescription() {
        if (!writingDescription || !writingData) return;
        const theme = writingData.themes.find((item) => item.name === selectedWritingTheme);
        writingDescription.textContent = theme?.note || '';
      }

      function applyWritingFilter(theme: string) {
        selectedWritingTheme = theme;
        visibleWritingRows = writingData?.pageSize || 6;
        document.querySelectorAll<HTMLButtonElement>('[data-theme]').forEach((button) => {
          button.setAttribute('aria-pressed', String(button.dataset.theme === theme));
        });
        updateThemeDescription();

        const render = () => {
          renderWritingSelection();
          requestAnimationFrame(() => writingContent?.classList.remove('is-filtering'));
        };
        if (writingMotion.matches) {
          writingContent?.classList.add('is-filtering');
          window.setTimeout(render, 150);
        } else {
          render();
        }
      }

      document.querySelectorAll<HTMLButtonElement>('[data-theme]').forEach((button) => {
        button.addEventListener('click', () => applyWritingFilter(button.dataset.theme || 'All'));
      });

      writingLoadMore?.addEventListener('click', () => {
        visibleWritingRows += writingData?.pageSize || 6;
        syncLoadMore(Array.from(writingList?.children || []) as HTMLLIElement[]);
      });

      if (writingData) {
        updateThemeDescription();
        syncLoadMore(Array.from(writingList?.children || []) as HTMLLIElement[]);
      }
</script>
