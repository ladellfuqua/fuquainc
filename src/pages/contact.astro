---
/**
 * Contact page redesign (LAD-37).
 * Presentation and field contract change only; delivery safeguards remain in
 * api/contact.js.
 */
import BaseLayout from '../layouts/BaseLayout.astro';
import PageHeaderBand from '../components/PageHeaderBand.astro';
import PageMotion from '../components/PageMotion.astro';

const linkedin = 'https://www.linkedin.com/in/ladellfuqua/';
---

<BaseLayout
  title="Contact"
  description="Get in touch with Ladell Fuqua — questions, ideas and introductions."
  headerTone="dark"
>
  <PageHeaderBand
    eyebrow="Contact"
    title="Get in touch."
    intro="For questions, ideas or introductions — the form below reaches me directly."
    variant="contact"
    linkHref={linkedin}
    linkLabel="Connect on LinkedIn"
  />

  <section class="contact-section" aria-label="Contact form" data-page-section>
    <div class="container contact-layout" data-page-parallax data-parallax-factor="0.03">
      <div class="contact-form-wrap">
        <div class="contact__panel" data-panel="form">
          <form class="form" id="contact-form" method="POST" action="/api/contact">
            <div class="field page-reveal">
              <label for="name">Name</label>
              <input id="name" name="name" type="text" autocomplete="name" required aria-required="true" />
              <p class="field__error" data-error-for="name" hidden></p>
            </div>

            <div class="field page-reveal" data-delay="1">
              <label for="email">Email</label>
              <input id="email" name="email" type="email" autocomplete="email" required aria-required="true" />
              <p class="field__error" data-error-for="email" hidden></p>
            </div>

            <div class="field page-reveal" data-delay="2">
              <label for="organization">Organization <span class="field__opt">(optional)</span></label>
              <input id="organization" name="organization" type="text" autocomplete="organization" />
            </div>

            <div class="field page-reveal" data-delay="3">
              <label for="message">Message</label>
              <textarea
                id="message"
                name="message"
                rows="7"
                placeholder="A few sentences is perfect."
                required
                aria-required="true"
              ></textarea>
              <p class="field__error" data-error-for="message" hidden></p>
            </div>

            <div class="hp" aria-hidden="true">
              <label for="website">Website</label>
              <input id="website" name="website" type="text" tabindex="-1" autocomplete="off" />
            </div>

            <div class="form__actions page-reveal" data-delay="4">
              <button type="submit" class="contact-submit" data-submit>Send message</button>
            </div>

            <p class="form__privacy page-reveal" data-delay="4">
              Your information is used only to review and respond to your message.
            </p>
          </form>
        </div>

        <div class="contact__panel contact__state" data-panel="success" hidden role="status" tabindex="-1">
          <h2>Message received.</h2>
          <p>Thank you for reaching out.</p>
        </div>

        <div class="contact__panel contact__state" data-panel="error" hidden role="alert" tabindex="-1">
          <h2>Your message could not be sent.</h2>
          <p>
            Please check the form and try again. If the problem continues, you can find me on{' '}
            <a href={linkedin} target="_blank" rel="noopener noreferrer">LinkedIn</a>.
          </p>
          <button type="button" class="contact__retry" data-retry>
            <span aria-hidden="true">&larr;</span> Back to the form
          </button>
        </div>
      </div>

      <aside class="elsewhere page-reveal" data-delay="2" aria-labelledby="elsewhere-title">
        <h2 id="elsewhere-title">Elsewhere</h2>
        <a class="elsewhere__linkedin" href={linkedin} target="_blank" rel="noopener noreferrer">
          linkedin.com/in/ladellfuqua <span aria-hidden="true">&rarr;</span>
        </a>
        <div class="elsewhere__glyphs" aria-hidden="true">
          <svg viewBox="0 0 32 32" focusable="false">
            <rect x="4.5" y="7.5" width="23" height="17" rx="2" />
            <path d="m6 9 10 8 10-8" />
          </svg>
          <svg viewBox="0 0 32 32" focusable="false">
            <path d="M10.2 5.5 6.7 9c-1.1 1.1.4 5.3 4.4 9.3s8.2 5.5 9.3 4.4l3.5-3.5-5-4-2.4 2.4c-1.5-.7-3.4-2.6-4.1-4.1l2.4-2.4-4.6-5.6Z" />
          </svg>
          <svg viewBox="0 0 32 32" focusable="false">
            <path d="m13.2 18.8 5.6-5.6M11.2 21.6l-1.7 1.7a4 4 0 0 1-5.7-5.7l4.7-4.7a4 4 0 0 1 5.7 0M20.8 10.4l1.7-1.7a4 4 0 1 1 5.7 5.7l-4.7 4.7a4 4 0 0 1-5.7 0" />
          </svg>
        </div>
      </aside>
    </div>
  </section>

  <PageMotion />
</BaseLayout>

<style>
  .contact-section {
    position: relative;
    overflow: hidden;
    padding-block: clamp(3.75rem, 6.5vw, 5.75rem);
    background: var(--c-ivory);
  }

  .contact-layout {
    display: grid;
    grid-template-columns: minmax(0, 1.65fr) minmax(16rem, 0.75fr);
    gap: clamp(3rem, 4vw, 6rem);
    align-items: start;
  }

  .contact-form-wrap { min-width: 0; }

  .form {
    display: grid;
    gap: 1.35rem;
    max-width: 38rem;
  }

  .field {
    display: grid;
    gap: 0.5rem;
  }

  .field label {
    color: var(--c-navy);
    font-size: var(--fs-sm);
    font-weight: var(--weight-medium);
  }

  .field__opt {
    color: var(--text-muted);
    font-weight: var(--weight-normal);
  }

  .field input,
  .field textarea {
    width: 100%;
    padding: 0.78rem 0.9rem;
    color: var(--heading);
    background: #fff;
    border: 1px solid #c9c2b7;
    border-radius: 8px;
  }

  .field textarea {
    min-height: 10rem;
    resize: vertical;
    line-height: var(--lh-body);
  }

  .field textarea::placeholder { color: #8b8c8d; }

  .field input:hover,
  .field textarea:hover { border-color: var(--c-navy); }

  .field input:focus-visible,
  .field textarea:focus-visible {
    outline: 0;
    border-color: var(--c-plum);
    box-shadow: 0 0 0 3px color-mix(in srgb, var(--c-plum) 24%, transparent);
  }

  .field input[aria-invalid='true'],
  .field textarea[aria-invalid='true'] { border-color: var(--c-plum-deep); }

  .field__error {
    color: var(--c-plum-deep);
    font-size: var(--fs-sm);
  }

  .contact-submit {
    min-height: 2.9rem;
    padding: 0.78rem 1.35rem;
    color: #fff;
    background: var(--c-navy);
    border: 1px solid var(--c-navy);
    border-radius: 8px;
    cursor: pointer;
    font-size: var(--fs-sm);
    font-weight: var(--weight-medium);
  }

  .contact-submit:hover,
  .contact-submit:focus-visible {
    color: #fff;
    background: var(--c-plum);
    border-color: var(--c-plum);
  }

  [data-submit][aria-busy='true'] {
    opacity: 0.7;
    pointer-events: none;
  }

  .form__privacy {
    color: var(--text-muted);
    font-size: var(--fs-sm);
  }

  .elsewhere {
    padding-top: 1.05rem;
    border-top: 2px solid var(--c-navy);
  }

  .elsewhere h2 {
    color: var(--c-plum-deep);
    font-family: var(--font-sans);
    font-size: var(--fs-eyebrow);
    font-weight: var(--weight-semi);
    letter-spacing: var(--tracking-eyebrow);
    text-transform: uppercase;
  }

  .elsewhere__linkedin {
    position: relative;
    display: inline-block;
    margin-top: 1.25rem;
    color: var(--c-plum-deep);
    font-size: var(--fs-sm);
    overflow-wrap: anywhere;
  }

  .elsewhere__glyphs {
    display: flex;
    gap: 1.15rem;
    margin-top: 2rem;
    padding-top: 1.35rem;
    border-top: 1px solid var(--line);
    color: var(--c-plum);
  }

  .elsewhere__glyphs svg {
    width: 1.55rem;
    height: 1.55rem;
    fill: none;
    stroke: currentColor;
    stroke-width: 1.45;
    stroke-linecap: round;
    stroke-linejoin: round;
  }

  .contact__state {
    max-width: 38rem;
    padding-block: 1rem;
  }

  .contact__state h2 {
    color: var(--c-navy);
    font-family: var(--font-serif);
    font-size: clamp(2rem, 1.7rem + 1.2vw, 2.65rem);
    font-weight: var(--weight-normal);
  }

  .contact__state p { margin-top: 1rem; }

  .contact__retry {
    margin-top: 1.25rem;
    padding: 0;
    color: var(--accent);
    background: none;
    border: 0;
    cursor: pointer;
  }

  .hp {
    position: absolute;
    left: -10000px;
    width: 1px;
    height: 1px;
    overflow: hidden;
  }

  @media (max-width: 52rem) {
    .contact-layout {
      grid-template-columns: 1fr;
      gap: 3.5rem;
    }

    .form { max-width: none; }
    .elsewhere { max-width: 38rem; }
  }

  @media (max-width: 30rem) {
    .contact-section { padding-block: 3.25rem; }
  }

  @media (prefers-reduced-motion: no-preference) {
    .field input,
    .field textarea {
      transition: border-color var(--dur-fast) var(--ease), box-shadow var(--dur-fast) var(--ease);
    }

    .contact-submit {
      transition: background-color var(--dur-fast) var(--ease), border-color var(--dur-fast) var(--ease);
    }
  }
</style>

<script>
  type PanelName = 'form' | 'success' | 'error';

  const contactForm = document.getElementById('contact-form') as HTMLFormElement | null;
  const contactPanels = new Map<PanelName, HTMLElement>();
  let contactSubmitting = false;
  document.querySelectorAll<HTMLElement>('[data-panel]').forEach((element) => {
    contactPanels.set(element.dataset.panel as PanelName, element);
  });

  function showContactState(state: PanelName, focusState = true) {
    contactPanels.forEach((element, name) => {
      element.hidden = name !== state;
    });
    if (state !== 'form') {
      window.scrollTo({ top: 0, behavior: 'auto' });
      if (focusState) contactPanels.get(state)?.focus();
    }
  }

  const contactUrlState = new URLSearchParams(location.search).get('state');
  if (contactUrlState === 'success' || contactUrlState === 'error') showContactState(contactUrlState);

  const contactEmailPattern = /^[^\s@]+@[^\s@]+\.[^\s@]+$/;

  function validateContactForm(): boolean {
    if (!contactForm) return false;
    const checks: Array<[string, (value: string) => boolean, string]> = [
      ['name', (value) => value.trim().length > 0, 'Please enter your name.'],
      ['email', (value) => contactEmailPattern.test(value.trim()), 'Please enter a valid email address.'],
      ['message', (value) => value.trim().length > 0, 'Please enter a message.'],
    ];
    let firstInvalid: HTMLElement | null = null;
    for (const [id, test, message] of checks) {
      const input = contactForm.elements.namedItem(id) as HTMLInputElement | HTMLTextAreaElement | null;
      const error = contactForm.querySelector<HTMLElement>(`[data-error-for="${id}"]`);
      const valid = input ? test(input.value) : false;
      if (input) {
        input.setAttribute('aria-invalid', valid ? 'false' : 'true');
        if (error && !valid) input.setAttribute('aria-describedby', `err-${id}`);
        else input.removeAttribute('aria-describedby');
      }
      if (error) {
        error.id = `err-${id}`;
        error.textContent = valid ? '' : message;
        error.hidden = valid;
      }
      if (!valid && !firstInvalid) firstInvalid = input;
    }
    firstInvalid?.focus();
    return !firstInvalid;
  }

  contactForm?.querySelectorAll<HTMLElement>('input, textarea').forEach((element) => {
    element.addEventListener('input', () => {
      if (element.getAttribute('aria-invalid') !== 'true') return;
      element.removeAttribute('aria-invalid');
      element.removeAttribute('aria-describedby');
      const error = contactForm.querySelector<HTMLElement>(`[data-error-for="${element.id}"]`);
      if (error) {
        error.textContent = '';
        error.hidden = true;
      }
    });
  });

  contactForm?.addEventListener('submit', async (event) => {
    event.preventDefault();
    if (contactSubmitting || !validateContactForm()) return;

    const button = contactForm.querySelector<HTMLButtonElement>('[data-submit]');
    contactSubmitting = true;
    contactForm.setAttribute('aria-busy', 'true');
    button?.setAttribute('aria-busy', 'true');
    if (button) {
      button.disabled = true;
      button.textContent = 'Sending…';
    }

    try {
      const data = Object.fromEntries(new FormData(contactForm).entries());
      const response = await fetch(contactForm.action, {
        method: 'POST',
        headers: { 'Content-Type': 'application/json', Accept: 'application/json' },
        body: JSON.stringify(data),
      });
      showContactState(response.ok ? 'success' : 'error');
      if (response.ok && typeof (window as any).gtag === 'function') {
        (window as any).gtag('event', 'contact_form_submit');
      }
    } catch {
      showContactState('error');
    } finally {
      contactSubmitting = false;
      contactForm.removeAttribute('aria-busy');
      button?.removeAttribute('aria-busy');
      if (button) {
        button.disabled = false;
        button.textContent = 'Send message';
      }
    }
  });

  document.querySelector('[data-retry]')?.addEventListener('click', () => {
    showContactState('form');
    document.getElementById('name')?.focus();
  });
</script>
