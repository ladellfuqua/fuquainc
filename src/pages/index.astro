---
import BaseLayout from '../layouts/BaseLayout.astro';
import BrandGraphic from '../components/BrandGraphic.astro';
import {
  articleHref,
  formatArticleMonth,
  getPublishedArticles,
} from '../lib/articles';
import { Picture } from 'astro:assets';
import anchorImg from '../assets/ladell-portrait.png';

// About-me personal-beat candid — single cycling shot (kitchen benched; Sitges dropped).
const candids = [
  { src: '/images/about-preview/cycling-skyline.webp', alt: 'Ladell cycling by the NYC waterfront', label: 'Cycling · NYC' },
];

// How I Think (LAD-28) — one typographic block; no icons or illustrations.
const principles = [
  {
    number: '01',
    title: 'Growth is a system',
    body: 'It happens when ideas, people, technology and opportunity connect — rarely inside one department.',
  },
  {
    number: '02',
    title: 'Teams outperform heroes',
    body: 'Shared goals, clear decision rights and enough trust beat any org chart.',
  },
  {
    number: '03',
    title: 'Clarity is the work',
    body: "Most stalled work isn't a strategy problem or a talent problem — no one agrees on what matters or who decides.",
  },
];

const latestArticles = (await getPublishedArticles()).slice(0, 3);
---

<BaseLayout
  title="Fuqua Inc."
  description="Fuqua Inc. is the platform of Ladell Fuqua: ideas and work on building growth by connecting ideas, people, technology and opportunity."
  bareTitle={true}
  headerTone="dark"
>
  <link
    slot="head"
    rel="preload"
    as="image"
    type="image/webp"
    href="/images/hero/hero-backdrop-1600.webp"
    imagesrcset="/images/hero/hero-backdrop-1000.webp 1000w, /images/hero/hero-backdrop-1600.webp 1600w, /images/hero/hero-backdrop-2400.webp 2400w"
    imagesizes="100vw"
    fetchpriority="high"
  />
  <link
    slot="head"
    rel="preload"
    as="image"
    type="image/webp"
    href="/images/hero/portrait-560.webp"
    imagesrcset="/images/hero/portrait-560.webp 560w, /images/hero/portrait-760.webp 760w, /images/hero/portrait-1120.webp 1120w"
    imagesizes="(max-width: 56.24rem) min(82vw, 22rem), 20rem"
    fetchpriority="high"
  />

  {/* ---------- Opening (dark, current backdrop) ---------- */}
  <section class="open">
    <div class="open__backdrop" aria-hidden="true">
      <img
        class="open__backdrop-img"
        src="/images/hero/hero-backdrop-1600.webp"
        srcset="/images/hero/hero-backdrop-1000.webp 1000w, /images/hero/hero-backdrop-1600.webp 1600w, /images/hero/hero-backdrop-2400.webp 2400w"
        sizes="100vw" alt="" width="1600" height="900" fetchpriority="high"
      />
      <span class="open__scrim"></span>
    </div>
    <div class="container open__copy">
      <p class="eyebrow open__eyebrow">Ladell Fuqua</p>
      <h1 class="open__title">Curious about people, and the ideas that bring us together.</h1>
    </div>
  </section>

  {/* ---------- About me (merged home) ---------- */}
  <section class="section am" aria-labelledby="am-heading">
    <div class="container">
      {/* Movement 1 — professional */}
      <div class="am__grid">
        <div class="am__lede">
          <h2 id="am-heading" class="visually-hidden">About Ladell Fuqua</h2>
          <p class="am__intro">
            Throughout my career, I&rsquo;ve been drawn to complex situations where listening carefully,
            connecting different perspectives and helping people find a clearer way forward can make a
            difference.
          </p>
          <p class="am__body">
            Most of my career has been in media &mdash; at AOL, Cond&eacute; Nast and TheStreet &mdash; in
            leadership roles across marketing, technology and operations. What I&rsquo;ve enjoyed most is
            helping teams turn ideas into results, and watching people grow in confidence along the way.
          </p>
        </div>
        <figure class="am__anchor">
          <div class="am__anchor-frame">
            <Picture
              src={anchorImg}
              formats={['avif', 'webp']}
              widths={[280, 440]}
              sizes="(max-width: 48rem) 40vw, 14rem"
              alt="Portrait of Ladell Fuqua"
              class="am__anchor-img"
            />
          </div>
          <figcaption class="am__anchor-cap">
            Chief Operating Officer &amp; Head&nbsp;of&nbsp;Growth<br /><span>PWX Solutions · New York</span>
          </figcaption>
        </figure>
      </div>

      <hr class="am__rule" />

      {/* Movement 2 — personal */}
      <div class="am__grid am__grid--rev">
        <div class="am__lede">
          <p class="am__body">
            I&rsquo;ve had the opportunity to work with many great people over the years. Many of those
            relationships continue today, well beyond the roles and companies where they began. Colleagues
            have become close friends, and I&rsquo;ve learned a great deal from them about work, life and myself.
          </p>
          <p class="am__body">
            New York is home, and I live in Harlem. My immediate family resides in Nashville, TN. Outside
            work, I enjoy cycling, traveling and art, and I&rsquo;m a member of both the Whitney Museum and the
            Studio Museum in Harlem. Music is a constant, especially jazz, with plenty of old school and house
            in the mix. I&rsquo;m an introvert who appreciates a quiet night in, but I also enjoy catching up
            with friends over a good bourbon. I write here about work, technology and culture, and how they
            shape our everyday lives.
          </p>
        </div>
        <figure class="am__candid">
          <div class="am__candid-frame">
            <img id="pv-candid" src={candids[0].src} alt={candids[0].alt} width="760" height="950" loading="lazy" />
          </div>
          <figcaption class="am__candid-cap"><span id="pv-candid-label">{candids[0].label}</span></figcaption>
        </figure>
      </div>
    </div>
  </section>

  {/* ---------- Writing (section 01) ---------- */}
  <section class="writing home-section-motion" aria-labelledby="writing-heading" data-home-section>
    <div class="container" data-home-parallax>
      <div class="writing__head home-reveal">
        <h2 id="writing-heading" class="eyebrow">
          <span class="writing__index" aria-hidden="true">01</span> Writing
        </h2>
        <a href="/writing" class="writing__all">All articles <span aria-hidden="true">&rarr;</span></a>
      </div>
      <p class="writing__dek home-reveal" style="--home-delay: 1">Occasional short articles on work, technology, culture and belonging.</p>

      {
        latestArticles.length > 0 ? latestArticles.map((article, index) => (
          <a href={articleHref(article)} class="writing-entry home-reveal" style={`--home-delay: ${index + 2}`}>
            <time class="writing-entry__date" datetime={article.data.publishedAt.toISOString()}>
              {formatArticleMonth(article.data.publishedAt)}
            </time>
            <div class="writing-entry__body">
              <h3 class="writing-entry__title"><span>{article.data.title}</span></h3>
              <p class="writing-entry__deck">{article.data.deck}</p>
              <span class="writing-entry__theme">{article.data.themes[0]}</span>
            </div>
          </a>
        )) : (
          <p class="writing__empty">No articles are published right now.</p>
        )
      }
    </div>
  </section>

  {/* ---------- How I Think (section 02) ---------- */}
  <section class="section section--navy pov home-section-motion" data-home-section>
    <div class="pov__field" aria-hidden="true">
      <BrandGraphic variant="field" />
    </div>
    <div class="container pov__inner" data-home-parallax>
      <h2 class="eyebrow pov__heading home-reveal">
        <span class="pov__index" aria-hidden="true">02</span> How I Think
      </h2>
      <ol class="pov__panels" role="list">
        {
          principles.map((principle, index) => (
            <li class="pov__panel home-reveal" style={`--home-delay: ${index + 1}`}>
              <span class="pov__number" aria-hidden="true">
                {principle.number}
              </span>
              <h3 class="pov__title">{principle.title}</h3>
              <p class="pov__body">{principle.body}</p>
            </li>
          ))
        }
      </ol>
    </div>
  </section>

  {/* ---------- Stay in touch (LAD-31) ---------- */}
  <section class="section--tight connect home-section-motion" aria-labelledby="connect-heading" data-home-section>
    <div class="container connect__inner" data-home-parallax>
      <h2 id="connect-heading" class="eyebrow home-reveal">Stay in touch</h2>
      <div class="connect__links home-reveal" style="--home-delay: 1">
        <a
          href="https://www.linkedin.com/in/ladellfuqua/"
          class="arrow-link"
          target="_blank"
          rel="me noopener"
        >
          Connect on LinkedIn <span class="arrow" aria-hidden="true">&rarr;</span>
        </a>
        <a href="/contact" class="arrow-link">
          Contact <span class="arrow" aria-hidden="true">&rarr;</span>
        </a>
      </div>
    </div>
  </section>

</BaseLayout>

<style>
  /* ---------- Writing ---------- */
  .writing {
    position: relative;
    overflow: hidden;
    padding-block: clamp(2.5rem, 2rem + 2vw, 3.75rem);
    background: var(--bg-alt);
  }
  .writing__head {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    gap: 1rem;
    flex-wrap: wrap;
  }
  .writing__index {
    margin-right: 0.55rem;
    color: var(--accent);
  }
  .writing__all {
    color: var(--heading);
    font-size: var(--fs-sm);
    font-weight: var(--weight-medium);
  }
  .writing__all:hover {
    color: var(--accent);
    text-decoration: none;
  }
  .writing__dek {
    margin-top: 0.55rem;
    color: var(--text);
    font-family: var(--font-serif);
    font-size: var(--fs-md);
  }
  .writing-entry {
    display: grid;
    grid-template-columns: 118px minmax(0, 1fr);
    gap: clamp(1rem, 0.5rem + 2vw, 2.5rem);
    margin-top: clamp(1.5rem, 1.15rem + 1.3vw, 2.1rem);
    padding-block: 18px;
    border-block: 1px solid var(--line);
    color: inherit;
  }
  .writing-entry:hover {
    text-decoration: none;
  }
  .writing-entry__date {
    padding-top: 0.15rem;
    color: var(--text-muted);
    font-size: 0.82rem;
    letter-spacing: 0.04em;
    text-transform: uppercase;
  }
  .writing-entry__body {
    min-width: 0;
  }
  .writing-entry__title {
    color: var(--heading);
    font-family: var(--font-serif);
    font-size: 1.3125rem;
    font-weight: var(--weight-semi);
    line-height: var(--lh-snug);
  }
  .writing-entry__title span {
    position: relative;
    display: inline;
    background-image: linear-gradient(var(--accent), var(--accent));
    background-position: 0 100%;
    background-repeat: no-repeat;
    background-size: 0 1px;
  }
  .writing-entry:hover .writing-entry__title span,
  .writing-entry:focus-visible .writing-entry__title span {
    background-size: 100% 1px;
  }
  .writing-entry__deck {
    margin-top: 0.35rem;
    color: var(--text);
    font-family: var(--font-serif);
    font-size: 0.9375rem;
    font-style: italic;
  }
  .writing-entry__theme {
    display: block;
    margin-top: 0.65rem;
    color: var(--accent);
    font-size: 0.7rem;
    font-weight: var(--weight-semi);
    letter-spacing: 0.12em;
    text-transform: uppercase;
  }
  .writing__empty {
    margin-top: 1.5rem;
    padding-block: 18px;
    border-block: 1px solid var(--line);
    color: var(--text-muted);
  }
  @media (prefers-reduced-motion: no-preference) {
    .writing-entry__body {
      transition: transform var(--dur) var(--ease);
    }
    .writing-entry__title span {
      transition: background-size var(--dur) var(--ease);
    }
    .writing-entry:hover .writing-entry__body,
    .writing-entry:focus-visible .writing-entry__body {
      transform: translateX(0.5rem);
    }
  }
  @media (max-width: 36rem) {
    .writing-entry {
      grid-template-columns: 1fr;
      gap: 0.55rem;
    }
    .writing-entry__date {
      padding-top: 0;
    }
  }

  /* ---------- How I Think ---------- */
  .pov {
    position: relative;
    overflow: hidden;
  }
  .pov__field {
    position: absolute;
    inset: 0;
    pointer-events: none;
    opacity: 0.18;
  }
  .pov__field :global(.bg-graphic) {
    width: 100%;
    height: 100%;
  }
  .pov__inner {
    position: relative;
  }
  .pov__heading {
    margin-bottom: clamp(2rem, 1.5rem + 2vw, 3.25rem);
  }
  .pov__index {
    margin-right: 0.55rem;
  }
  .pov__panels {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    list-style: none;
    padding: 0;
    margin: 0;
    border-block: 1px solid var(--on-dark-line);
  }
  .pov__panel {
    position: relative;
    min-height: 19rem;
    padding: clamp(2rem, 1.5rem + 2.2vw, 3rem);
    transition: background-color var(--dur) var(--ease);
  }
  .pov__panel + .pov__panel {
    border-left: 1px solid var(--on-dark-line);
  }
  .pov__panel:hover {
    background: var(--c-navy-soft);
  }
  .pov__number {
    display: block;
    font-size: 0.8rem;
    font-weight: var(--weight-semi);
    letter-spacing: 0.14em;
    color: #c9adc0;
    margin-bottom: clamp(2rem, 1.5rem + 1vw, 2.75rem);
  }
  .pov__title {
    max-width: 13ch;
    color: var(--on-dark);
    font-size: clamp(1.55rem, 1.25rem + 1vw, 2rem);
    line-height: 1.14;
  }
  .pov__body {
    max-width: 31ch;
    margin-top: 1.15rem;
    color: #c6cdd5;
    font-size: clamp(0.98rem, 0.94rem + 0.16vw, 1.08rem);
    line-height: 1.65;
  }
  @media (max-width: 52rem) {
    .pov__panels {
      grid-template-columns: 1fr;
    }
    .pov__panel {
      min-height: 0;
    }
    .pov__panel + .pov__panel {
      border-top: 1px solid var(--on-dark-line);
      border-left: 0;
    }
    .pov__number {
      margin-bottom: 1.5rem;
    }
    .pov__title,
    .pov__body {
      max-width: var(--measure-narrow);
    }
  }

  /* ---------- About / bio ---------- */
  .bio {
    background: var(--bg);
    overflow: hidden;
    padding-block: clamp(3rem, 2.5rem + 1.5vw, 4rem);
  }
  .bio__inner {
    padding-block: 0;
  }
  .bio__heading {
    margin-bottom: clamp(1.5rem, 1.1rem + 1.4vw, 2rem);
  }
  .bio__copy {
    max-width: 30em;
    color: var(--text);
    font-family: var(--font-serif);
    font-size: clamp(1.3rem, 1.08rem + 0.8vw, 1.7rem);
    line-height: 1.55;
  }
  .bio__copy strong {
    color: var(--c-navy);
    font-weight: var(--weight-semi);
  }
  .bio__quote {
    max-width: 36em;
    margin-top: clamp(2rem, 1.6rem + 1.4vw, 2.5rem);
    padding-left: 1.35rem;
    border-left: 2px solid var(--accent);
    color: var(--text);
    font-family: var(--font-serif);
    font-size: clamp(1rem, 0.96rem + 0.14vw, 1.06rem);
    font-style: italic;
    line-height: 1.55;
  }
  .bio__quote-line {
    display: block;
  }

  @media (prefers-reduced-motion: no-preference) {
    :global(html[data-motion='enabled']) .bio--prepared .bio__word {
      display: inline-block;
      opacity: 0;
      transform: translateY(0.875rem);
      transition:
        opacity 620ms var(--ease),
        transform 620ms var(--ease);
      transition-delay: calc(var(--word-index) * 26ms);
    }
    :global(html[data-motion='enabled']) .bio--prepared.bio--visible .bio__word {
      opacity: 1;
      transform: none;
    }
    :global(html[data-motion='enabled']) .bio--prepared .bio__quote-line {
      overflow: hidden;
    }
    :global(html[data-motion='enabled']) .bio--prepared .bio__quote-line > span {
      display: block;
      transform: translateY(115%);
      transition: transform 820ms var(--ease);
    }
    :global(html[data-motion='enabled'])
      .bio--prepared.bio--visible
      .bio__quote-line
      > span {
      transform: none;
    }
    :global(html[data-motion='enabled'])
      .bio--prepared.bio--visible
      .bio__quote-line:nth-child(2)
      > span {
      transition-delay: 110ms;
    }
  }

  /* ---------- Connect ---------- */
  .connect {
    position: relative;
    overflow: hidden;
    background: var(--bg);
    border-top: 1px solid var(--line);
  }
  .connect__inner {
    display: grid;
    align-items: center;
    justify-items: center;
    gap: 1.25rem;
    text-align: center;
  }
  .connect__links {
    display: flex;
    align-items: center;
    justify-content: center;
    flex-wrap: wrap;
    gap: 0.9rem clamp(1.5rem, 1rem + 2vw, 2.5rem);
  }

  @media (prefers-reduced-motion: no-preference) {
    :global(html[data-motion='enabled'] main.home-motion-ready) .home-reveal {
      opacity: 0;
      transform: translateY(2rem);
      transition: opacity 880ms var(--ease), transform 880ms var(--ease);
      transition-delay: calc(var(--home-delay, 0) * 120ms);
    }

    :global(html[data-motion='enabled'] main.home-motion-ready) .home-reveal.is-visible {
      opacity: 1;
      transform: none;
    }

    :global(html[data-motion='enabled'] main.home-motion-ready) .home-section-motion::after {
      content: '';
      position: absolute;
      z-index: 5;
      top: 0;
      right: var(--gutter);
      left: var(--gutter);
      height: 1px;
      pointer-events: none;
      opacity: 0;
      transform: scaleX(0.18);
      transform-origin: left;
      background: color-mix(in srgb, var(--c-plum) 42%, transparent);
      transition: opacity 900ms var(--ease), transform 1100ms var(--ease);
    }

    :global(html[data-motion='enabled'] main.home-motion-ready) .home-section-motion.is-section-visible::after {
      opacity: 0.48;
      transform: scaleX(1);
    }

    :global(html[data-motion='enabled'] main.home-motion-ready) [data-home-parallax] {
      transform: translate3d(0, var(--home-parallax, 0), 0);
    }

    :global(html[data-motion='enabled'] main.home-motion-ready) .pov__field {
      transform: scale(1.035);
      transition: transform 1600ms var(--ease), opacity 1200ms var(--ease);
    }

    :global(html[data-motion='enabled'] main.home-motion-ready) .pov.is-section-visible .pov__field {
      transform: scale(1);
      opacity: 0.24;
    }
  }

  /* ---------- Opening (always dark, current-site backdrop) ---------- */
  .open {
    position: relative;
    overflow: hidden;
    min-height: clamp(12rem, 27vh, 16rem);
    display: grid;
    align-items: center;
    padding-block: clamp(1.75rem, 1rem + 2vw, 3rem);
  }
  .open__backdrop { position: absolute; inset: 0; z-index: 0; overflow: hidden; }
  .open__backdrop-img { width: 100%; height: 100%; object-fit: cover; object-position: 50% 38%; display: block; }
  .open__scrim {
    position: absolute;
    inset: 0;
    background:
      linear-gradient(100deg, rgba(13,20,31,0.95) 0%, rgba(13,20,31,0.82) 42%, rgba(13,20,31,0.52) 78%, rgba(13,20,31,0.68) 100%),
      linear-gradient(180deg, rgba(11,17,27,0.55), transparent 34%, rgba(11,17,27,0.42));
  }
  .open__copy { position: relative; z-index: 1; }
  .open__eyebrow { color: #d5b9ce; }
  .open__title {
    margin-top: 0.7rem;
    max-width: none;
    color: #f6f3ec;
    font-family: var(--font-serif);
    font-weight: var(--weight-normal, 400);
    font-size: clamp(1.5rem, 1.05rem + 1.9vw, 2.4rem);
    line-height: 1.2;
    letter-spacing: -0.01em;
    text-wrap: pretty;
  }
  .open__cred { margin-top: 1.5rem; color: #e6e8eb; font-size: 0.82rem; font-weight: 600; }
  .open__cred span { font-weight: 400; opacity: 0.72; }

  /* ---------- About me (merged home) ---------- */
  .am { background: var(--bg, #f7f5f0); }
  .am__grid {
    display: grid;
    grid-template-columns: minmax(0, 1fr) 14rem;
    gap: clamp(1.75rem, 1rem + 4vw, 4rem);
    align-items: start;
  }
  .am__grid--rev { grid-template-columns: minmax(0, 1fr) 12.5rem; }
  .am__eyebrow { margin-bottom: 0; }
  .am__intro {
    margin-top: 1.1rem;
    max-width: 46ch;
    color: var(--c-navy);
    font-family: var(--font-serif);
    font-size: clamp(1.12rem, 1rem + 0.5vw, 1.35rem);
    line-height: 1.5;
  }
  .am__body {
    margin-top: 1.25rem;
    max-width: 60ch;
    color: var(--c-graphite);
    font-size: var(--fs-base);
    line-height: 1.72;
  }
  .am__grid--rev .am__body:first-child { margin-top: 0; }
  .am__rule {
    margin-block: clamp(2rem, 1.4rem + 2vw, 3rem);
    border: 0;
    border-top: 1px solid var(--line, #d6d1c7);
  }
  .am__anchor, .am__candid { margin: 0; }
  .am__anchor-frame, .am__candid-frame {
    overflow: hidden;
    border-radius: var(--radius, 5px);
    aspect-ratio: 4 / 5;
    background: var(--c-stone);
  }
  .am__anchor-frame { border: 1px solid var(--line, #d6d1c7); }
  .am__anchor-img, .am__candid-frame img { width: 100%; height: 100%; object-fit: cover; display: block; }
  .am__anchor-img { object-position: 50% 22%; }
  .am__anchor-cap { margin-top: 0.7rem; color: var(--c-navy); font-size: 0.82rem; font-weight: 600; line-height: 1.35; }
  .am__anchor-cap span { color: var(--text-muted, #6b7178); font-weight: 400; }
  .am__candid-cap { margin-top: 0.55rem; font-size: 0.74rem; color: var(--text-muted, #6b7178); letter-spacing: 0.06em; text-transform: uppercase; }
  @media (max-width: 48rem) {
    .am__grid, .am__grid--rev { grid-template-columns: 1fr; }
    .am__anchor { max-width: 12rem; }
    .am__candid { max-width: 11rem; }
  }
</style>

<script>
  const bio = document.querySelector<HTMLElement>('.bio');
  const bioCopy = bio?.querySelector<HTMLElement>('[data-bio-reveal]');

  if (
    bio &&
    bioCopy &&
    document.documentElement.dataset.motion === 'enabled' &&
    'IntersectionObserver' in window
  ) {
    const walker = document.createTreeWalker(bioCopy, NodeFilter.SHOW_TEXT);
    const textNodes: Text[] = [];
    let node: Node | null;

    while ((node = walker.nextNode())) textNodes.push(node as Text);

    let wordIndex = 0;
    textNodes.forEach((textNode) => {
      const fragment = document.createDocumentFragment();
      textNode.textContent?.split(/(\s+)/).forEach((token) => {
        if (!token.trim()) {
          fragment.appendChild(document.createTextNode(token));
          return;
        }

        const word = document.createElement('span');
        word.className = 'bio__word';
        word.style.setProperty('--word-index', String(wordIndex));
        word.textContent = token;
        wordIndex += 1;
        fragment.appendChild(word);
      });
      textNode.replaceWith(fragment);
    });

    bio.classList.add('bio--prepared');
    const observer = new IntersectionObserver(
      ([entry]) => {
        if (!entry?.isIntersecting) return;
        bio.classList.add('bio--visible');
        observer.disconnect();
      },
      { threshold: 0.16, rootMargin: '0px 0px -6% 0px' }
    );
    observer.observe(bio);
  }

  const motionQuery = window.matchMedia('(prefers-reduced-motion: no-preference)');
  const main = document.querySelector<HTMLElement>('main');
  const homeRevealItems = Array.from(document.querySelectorAll<HTMLElement>('.home-reveal'));
  const homeSections = Array.from(document.querySelectorAll<HTMLElement>('[data-home-section]'));
  const homeParallaxItems = Array.from(document.querySelectorAll<HTMLElement>('[data-home-parallax]'));
  let homeRevealObserver: IntersectionObserver | undefined;
  let homeSectionObserver: IntersectionObserver | undefined;
  let homeFrame = 0;

  function disableHomeMotion() {
    main?.classList.remove('home-motion-ready');
    homeRevealObserver?.disconnect();
    homeSectionObserver?.disconnect();
    homeRevealObserver = undefined;
    homeSectionObserver = undefined;
    homeRevealItems.forEach((item) => item.classList.remove('is-visible'));
    homeSections.forEach((section) => section.classList.remove('is-section-visible'));
    homeParallaxItems.forEach((item) => {
      item.style.removeProperty('--home-parallax');
      item.style.removeProperty('transform');
    });
  }

  function updateHomeParallax() {
    homeFrame = 0;
    if (document.documentElement.dataset.motion !== 'enabled' || !motionQuery.matches) return;
    const viewport = Math.max(window.innerHeight, 1);
    homeParallaxItems.forEach((item) => {
      const rect = item.getBoundingClientRect();
      const centerOffset = (rect.top + rect.height / 2 - viewport / 2) / viewport;
      const shift = Math.max(-20, Math.min(20, centerOffset * -20));
      item.style.setProperty('--home-parallax', `${shift.toFixed(2)}px`);
      item.style.transform = `translate3d(0, ${shift.toFixed(2)}px, 0)`;
    });
  }

  function requestHomeParallax() {
    if (!homeFrame) homeFrame = window.requestAnimationFrame(updateHomeParallax);
  }

  function prepareHomeMotion() {
    if (
      document.documentElement.dataset.motion !== 'enabled' ||
      !motionQuery.matches ||
      !('IntersectionObserver' in window)
    ) {
      disableHomeMotion();
      return;
    }

    main?.classList.add('home-motion-ready');
    homeRevealObserver?.disconnect();
    homeRevealObserver = new IntersectionObserver(
      (entries) => {
        entries.forEach((entry) => {
          if (!entry.isIntersecting) return;
          (entry.target as HTMLElement).classList.add('is-visible');
          homeRevealObserver?.unobserve(entry.target);
        });
      },
      { threshold: 0.12, rootMargin: '0px 0px -6% 0px' }
    );
    homeRevealItems.forEach((item) => homeRevealObserver?.observe(item));

    homeSectionObserver?.disconnect();
    homeSectionObserver = new IntersectionObserver(
      (entries) => {
        entries.forEach((entry) => {
          if (!entry.isIntersecting) return;
          (entry.target as HTMLElement).classList.add('is-section-visible');
          homeSectionObserver?.unobserve(entry.target);
        });
      },
      { threshold: 0.08, rootMargin: '0px 0px -8% 0px' }
    );
    homeSections.forEach((section) => homeSectionObserver?.observe(section));
    requestHomeParallax();
  }

  window.addEventListener('scroll', requestHomeParallax, { passive: true });
  window.addEventListener('resize', requestHomeParallax, { passive: true });
  motionQuery.addEventListener?.('change', prepareHomeMotion);
  prepareHomeMotion();
</script>
