---
/**
 * Homepage hero (LAD-27).
 *
 * Motion is progressive enhancement: every element renders in its final,
 * readable position. Masks, drift, sweep, and the desktop recede effect only
 * activate after the global motion-readiness guard confirms support and the
 * visitor has not requested reduced motion.
 */
import { Picture } from 'astro:assets';
import portrait from '../assets/ladell-home-portrait.png';

const headlineLines = [
  'Building growth by',
  'connecting ideas,',
  'people, technology',
  'and opportunity.',
];
---

<section class="home-hero" aria-labelledby="home-hero-title">
  <div class="home-hero__backdrop" aria-hidden="true">
    <span class="home-hero__plane home-hero__plane--one"></span>
    <span class="home-hero__plane home-hero__plane--two"></span>
    <span class="home-hero__light"></span>
    <span class="home-hero__sweep"></span>
    <span class="home-hero__grain"></span>
  </div>

  <div class="home-hero__handoff" aria-hidden="true"></div>

  <div class="container home-hero__inner">
    <div class="home-hero__copy">
      <h1
        id="home-hero-title"
        class="home-hero__headline"
        aria-label="Building growth by connecting ideas, people, technology and opportunity."
      >
        {
          headlineLines.map((line, index) => (
            <span class="home-hero__line" aria-hidden="true">
              <span style={`--line-index: ${index}`}>{line}</span>
            </span>
          ))
        }
      </h1>

      <p class="home-hero__lead">
        I work across growth, marketing, technology and business transformation
        &mdash; often bringing different disciplines and teams together to solve
        problems that don&rsquo;t fit neatly within one function.
      </p>

      <a href="/about" class="home-hero__link">
        About Ladell <span aria-hidden="true">&rarr;</span>
      </a>
    </div>

    <figure class="home-hero__portrait">
      <div class="home-hero__portrait-frame">
        <Picture
          src={portrait}
          formats={['avif', 'webp']}
          widths={[280, 320, 400, 560]}
          sizes="(max-width: 56.24rem) min(72vw, 22rem), 20rem"
          alt="Ladell Fuqua"
          class="home-hero__portrait-image"
          priority
        />
      </div>
      <figcaption class="home-hero__caption">
        <span class="home-hero__caption-name">Ladell Fuqua</span>
        <span>COO, PWX Solutions &middot; New York</span>
      </figcaption>
    </figure>
  </div>
</section>

<style>
  .home-hero {
    --hero-progress: 0;
    position: relative;
    z-index: 0;
    display: grid;
    align-items: center;
    min-height: calc(100svh - 4.5rem);
    padding-block: clamp(3.5rem, 8vh, 6rem) clamp(6.5rem, 15vh, 9rem);
    overflow: hidden;
    isolation: isolate;
    color: var(--on-dark);
    background: var(--c-navy);
  }

  .home-hero__backdrop,
  .home-hero__backdrop::before,
  .home-hero__backdrop::after,
  .home-hero__plane,
  .home-hero__light,
  .home-hero__sweep,
  .home-hero__grain,
  .home-hero__handoff {
    position: absolute;
    pointer-events: none;
  }

  .home-hero__backdrop {
    z-index: -3;
    inset: -7%;
    overflow: hidden;
    transform: scale(calc(1 + var(--hero-progress) * 0.035));
    background:
      radial-gradient(ellipse at 72% 38%, rgba(159, 140, 155, 0.26), transparent 31%),
      radial-gradient(ellipse at 58% 66%, rgba(127, 145, 165, 0.2), transparent 35%),
      linear-gradient(112deg, #111c2a 5%, #182536 43%, #283346 70%, #171f2e 100%);
  }

  .home-hero__backdrop::before {
    content: '';
    inset: 10% 7% 13% 33%;
    opacity: 0.62;
    filter: blur(15px);
    background:
      linear-gradient(90deg, transparent 0 8%, rgba(227, 223, 216, 0.08) 8% 9%, transparent 9% 42%, rgba(227, 223, 216, 0.07) 42% 43%, transparent 43% 76%, rgba(227, 223, 216, 0.06) 76% 77%, transparent 77%),
      linear-gradient(180deg, rgba(227, 223, 216, 0.11) 0 1%, transparent 1% 47%, rgba(227, 223, 216, 0.06) 47% 48%, transparent 48% 84%, rgba(227, 223, 216, 0.05) 84% 85%, transparent 85%),
      radial-gradient(ellipse at 68% 48%, rgba(111, 83, 104, 0.35), transparent 54%);
  }

  .home-hero__backdrop::after {
    content: '';
    inset: 0;
    background:
      linear-gradient(96deg, rgba(15, 25, 39, 0.9) 0%, rgba(24, 37, 54, 0.74) 38%, rgba(24, 37, 54, 0.26) 76%, rgba(17, 27, 42, 0.5) 100%),
      linear-gradient(180deg, rgba(11, 18, 28, 0.3), transparent 30%, transparent 65%, rgba(11, 18, 28, 0.7));
  }

  .home-hero__plane {
    z-index: 1;
    display: block;
    border-left: 1px solid rgba(247, 245, 240, 0.08);
    transform: skewX(-12deg);
  }

  .home-hero__plane--one {
    inset: -15% auto -15% 48%;
    width: 17%;
    background: linear-gradient(110deg, rgba(247, 245, 240, 0.025), rgba(127, 145, 165, 0.07));
  }

  .home-hero__plane--two {
    inset: -15% -3% -15% auto;
    width: 30%;
    opacity: 0.55;
    background: linear-gradient(105deg, rgba(111, 83, 104, 0.08), transparent 72%);
  }

  .home-hero__light {
    z-index: 1;
    inset: 10% 4% 5% 49%;
    display: block;
    filter: blur(32px);
    background: radial-gradient(ellipse at center, rgba(186, 167, 182, 0.13), transparent 65%);
  }

  .home-hero__sweep {
    z-index: 2;
    top: -30%;
    bottom: -30%;
    left: -62%;
    display: block;
    width: 44%;
    transform: skewX(-14deg);
    background: linear-gradient(100deg, transparent, rgba(201, 173, 193, 0.06) 38%, rgba(227, 223, 216, 0.1) 52%, transparent);
  }

  .home-hero__grain {
    z-index: 3;
    inset: 0;
    display: block;
    opacity: 0.12;
    mix-blend-mode: soft-light;
    background:
      repeating-linear-gradient(23deg, rgba(255, 255, 255, 0.06) 0 1px, transparent 1px 4px),
      repeating-linear-gradient(117deg, rgba(0, 0, 0, 0.08) 0 1px, transparent 1px 5px);
    background-size: 7px 9px, 11px 13px;
  }

  .home-hero__handoff {
    z-index: 4;
    right: 0;
    bottom: 0;
    left: 0;
    height: clamp(5.5rem, 16vh, 9rem);
    background: linear-gradient(180deg, transparent 0%, rgba(24, 37, 54, 0.2) 28%, rgba(127, 145, 165, 0.4) 60%, rgba(227, 223, 216, 0.82) 84%, var(--c-ivory) 100%);
  }

  .home-hero__inner {
    position: relative;
    z-index: 5;
    display: grid;
    grid-template-columns: minmax(0, 1.55fr) minmax(17.5rem, 0.7fr);
    align-items: center;
    gap: clamp(3rem, 6vw, 5.5rem);
    transform: translateY(calc(var(--hero-progress) * -1.625rem)) scale(calc(1 - var(--hero-progress) * 0.07));
    transform-origin: 50% 42%;
    opacity: calc(1 - var(--hero-progress) * 0.84);
  }

  .home-hero__copy {
    padding-bottom: clamp(1rem, 4vh, 3rem);
  }

  .home-hero__headline {
    max-width: none;
    color: #f2efe8;
    font-size: clamp(3rem, 4.25vw, 3.9rem);
    font-weight: var(--weight-semi);
    line-height: 1.07;
    letter-spacing: -0.035em;
    text-wrap: initial;
  }

  .home-hero__line {
    display: block;
  }

  .home-hero__line > span {
    display: block;
    white-space: nowrap;
  }

  .home-hero__lead {
    max-width: 35rem;
    margin-top: 1.65rem;
    color: #d4d8de;
    font-size: clamp(1.05rem, 0.98rem + 0.25vw, 1.18rem);
    line-height: 1.7;
  }

  .home-hero__link {
    display: inline-flex;
    align-items: baseline;
    gap: 0.42em;
    margin-top: 2rem;
    padding-bottom: 0.14rem;
    border-bottom: 1px solid #bda4b6;
    color: #c9adc0;
    font-size: 1rem;
    font-weight: var(--weight-medium);
  }

  .home-hero__link:hover {
    color: #f2efe8;
    border-color: #f2efe8;
    text-decoration: none;
  }

  .home-hero__link span {
    transition: transform var(--dur) var(--ease);
  }

  .home-hero__link:hover span {
    transform: translateX(4px);
  }

  .home-hero__portrait {
    align-self: end;
    justify-self: end;
    width: min(20rem, 100%);
    margin: 0 0 clamp(2.5rem, 7vh, 4.5rem);
  }

  .home-hero__portrait-frame {
    position: relative;
    width: 100%;
  }

  .home-hero__portrait-frame::before {
    content: '';
    position: absolute;
    z-index: -1;
    inset: -14% -24% -4%;
    filter: blur(18px);
    background: radial-gradient(58% 54% at 50% 42%, rgba(159, 140, 155, 0.38), rgba(111, 83, 104, 0.17) 46%, transparent 74%);
  }

  .home-hero__portrait-frame :global(picture) {
    display: block;
    -webkit-mask-image: linear-gradient(180deg, #000 0%, #000 86%, transparent 100%);
    mask-image: linear-gradient(180deg, #000 0%, #000 86%, transparent 100%);
  }

  .home-hero__portrait-frame :global(.home-hero__portrait-image) {
    position: relative;
    z-index: 1;
    width: 100%;
    height: auto;
    filter: drop-shadow(0 1.65rem 2.25rem rgba(6, 10, 18, 0.54)) drop-shadow(0 0.3rem 0.8rem rgba(6, 10, 18, 0.32));
  }

  .home-hero__caption {
    position: relative;
    z-index: 6;
    margin-top: 0.55rem;
    color: #bdc4cc;
    font-size: 0.75rem;
    font-weight: var(--weight-medium);
    line-height: 1.45;
    text-align: right;
    text-shadow: 0 1px 12px rgba(6, 10, 18, 0.9);
  }

  .home-hero__caption-name {
    display: block;
    margin-bottom: 0.16rem;
    color: #e1e3e6;
    font-weight: var(--weight-semi);
    letter-spacing: 0.14em;
    text-transform: uppercase;
  }

  @media (prefers-reduced-motion: no-preference) {
    :global(html[data-motion='enabled']) .home-hero__backdrop {
      animation: home-hero-drift 36s var(--ease) infinite alternate;
    }

    :global(html[data-motion='enabled']) .home-hero__sweep {
      animation: home-hero-sweep 18s var(--ease) infinite;
    }

    :global(html[data-motion='enabled']) .home-hero__line {
      overflow: hidden;
    }

    :global(html[data-motion='enabled']) .home-hero__line > span {
      transform: translateY(112%);
      animation: home-hero-line 880ms var(--ease) forwards;
      animation-delay: calc(var(--line-index) * 110ms);
    }

    :global(html[data-motion='enabled']) .home-hero__lead,
    :global(html[data-motion='enabled']) .home-hero__link,
    :global(html[data-motion='enabled']) .home-hero__portrait {
      opacity: 0;
      animation: home-hero-fade 820ms var(--ease) forwards;
    }

    :global(html[data-motion='enabled']) .home-hero__lead {
      animation-delay: 500ms;
    }

    :global(html[data-motion='enabled']) .home-hero__link {
      animation-delay: 630ms;
    }

    :global(html[data-motion='enabled']) .home-hero__portrait {
      animation-delay: 390ms;
    }
  }

  @media (min-width: 56.25rem) and (min-height: 42rem) and (prefers-reduced-motion: no-preference) {
    :global(html[data-motion='enabled']) .home-hero {
      position: sticky;
      top: 4.5rem;
    }
  }

  @media (max-width: 56.24rem) {
    .home-hero {
      min-height: auto;
      padding-block: clamp(3rem, 8vw, 5rem) clamp(6.5rem, 18vw, 8.5rem);
    }

    .home-hero__inner {
      grid-template-columns: 1fr;
      gap: clamp(2.25rem, 7vw, 3.5rem);
      transform: none;
      opacity: 1;
    }

    .home-hero__handoff {
      height: clamp(4rem, 8vh, 5rem);
    }

    .home-hero__copy {
      padding-bottom: 0;
    }

    .home-hero__headline {
      max-width: 13ch;
      font-size: clamp(2.45rem, 8vw, 3.6rem);
      line-height: 1.08;
      text-wrap: balance;
    }

    .home-hero__line,
    .home-hero__line > span {
      display: inline;
      white-space: normal;
    }

    .home-hero__line:not(:last-child)::after {
      content: ' ';
    }

    .home-hero__portrait {
      justify-self: start;
      width: min(22rem, 76vw);
      margin: 0;
    }

    .home-hero__caption {
      text-align: left;
    }

    .home-hero__backdrop::after {
      background:
        linear-gradient(180deg, rgba(11, 18, 28, 0.55), rgba(24, 37, 54, 0.72) 47%, rgba(17, 27, 42, 0.72)),
        linear-gradient(96deg, rgba(15, 25, 39, 0.76), rgba(24, 37, 54, 0.25));
    }
  }

  @media (max-width: 30rem) {
    .home-hero {
      padding-top: 2.75rem;
    }

    .home-hero__headline {
      font-size: clamp(2.2rem, 10.5vw, 2.8rem);
    }

    .home-hero__lead {
      margin-top: 1.35rem;
      font-size: 1rem;
      line-height: 1.62;
    }

    .home-hero__link {
      margin-top: 1.55rem;
    }

    .home-hero__portrait {
      width: min(19rem, 82vw);
    }
  }

  @media (max-height: 34rem) and (orientation: landscape) {
    .home-hero {
      min-height: auto;
      padding-block: 2.5rem 6rem;
    }

    .home-hero__inner {
      grid-template-columns: minmax(0, 1.4fr) minmax(12rem, 0.6fr);
      gap: 2rem;
    }

    .home-hero__headline {
      max-width: none;
      font-size: clamp(2rem, 6vw, 3rem);
    }

    .home-hero__lead {
      margin-top: 1rem;
      font-size: 0.98rem;
      line-height: 1.5;
    }

    .home-hero__link {
      margin-top: 1.15rem;
    }

    .home-hero__portrait {
      justify-self: end;
      width: min(15rem, 30vw);
    }

    .home-hero__caption {
      text-align: right;
    }
  }

  @keyframes home-hero-line {
    to {
      transform: none;
    }
  }

  @keyframes home-hero-fade {
    to {
      opacity: 1;
    }
  }

  @keyframes home-hero-drift {
    from {
      transform: scale(calc(1.02 + var(--hero-progress) * 0.035)) translate3d(0, 0, 0);
    }
    to {
      transform: scale(calc(1.085 + var(--hero-progress) * 0.035)) translate3d(-1.3%, -0.8%, 0);
    }
  }

  @keyframes home-hero-sweep {
    0% {
      left: -62%;
    }
    56%,
    100% {
      left: 118%;
    }
  }

  :global(main > section:not(.home-hero)) {
    position: relative;
    z-index: 1;
  }
</style>

<script>
  const hero = document.querySelector<HTMLElement>('.home-hero');
  const heroInner = hero?.querySelector<HTMLElement>('.home-hero__inner');
  const desktopMotion = window.matchMedia(
    '(min-width: 56.25rem) and (min-height: 42rem) and (prefers-reduced-motion: no-preference)'
  );
  let frame = 0;

  function resetHero() {
    hero?.style.removeProperty('--hero-progress');
    heroInner?.style.removeProperty('will-change');
  }

  function updateHero() {
    frame = 0;
    if (
      !hero ||
      !heroInner ||
      document.documentElement.dataset.motion !== 'enabled' ||
      !desktopMotion.matches
    ) {
      resetHero();
      return;
    }

    const progress = Math.min(
      1,
      Math.max(0, window.scrollY / Math.max(window.innerHeight * 0.72, 1))
    );
    hero.style.setProperty('--hero-progress', progress.toFixed(4));
    heroInner.style.setProperty('will-change', progress > 0 ? 'transform, opacity' : 'auto');
  }

  function requestHeroUpdate() {
    if (!frame) frame = window.requestAnimationFrame(updateHero);
  }

  window.addEventListener('scroll', requestHeroUpdate, { passive: true });
  window.addEventListener('resize', requestHeroUpdate, { passive: true });
  desktopMotion.addEventListener?.('change', requestHeroUpdate);
  requestHeroUpdate();
</script>
