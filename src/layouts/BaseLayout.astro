---
/**
 * BaseLayout — document shell, SEO, structured data. (§25)
 */
import '../styles/global.css';
import SiteHeader from '../components/SiteHeader.astro';
import SiteFooter from '../components/SiteFooter.astro';
import SiteMotion from '../components/SiteMotion.astro';
import { getImage } from 'astro:assets';
import portrait from '../assets/ladell-portrait.png';

interface Props {
  title: string;
  description: string;
  /** Path-relative or absolute OG image; defaults to site card. */
  image?: string;
  imageWidth?: number;
  imageHeight?: number;
  /** Accessible description of the social image. */
  imageAlt?: string;
  /** Override the document type for structured data on article pages. */
  type?: 'website' | 'article';
  /** Suppress " — Fuqua Inc." title suffix (e.g. homepage). */
  bareTitle?: boolean;
  /** Page-level header treatment. */
  headerTone?: 'light' | 'dark';
  /** Let the shared header own its scroll-state transition. */
  manageHeaderScroll?: boolean;
  /** Render the document-level progress/footer motion controller. */
  siteMotion?: boolean;
  /** Optional page-level body class for template-specific composition. */
  bodyClass?: string;
  noindex?: boolean;
}

const {
  title,
  description,
  image = '/og-home-2026.png',
  imageWidth = 1200,
  imageHeight = 630,
  imageAlt = 'Fuqua Inc. — Ladell Fuqua',
  type = 'website',
  bareTitle = false,
  headerTone = 'light',
  manageHeaderScroll = true,
  siteMotion = true,
  bodyClass,
  noindex = false,
} = Astro.props;

const siteName = 'Fuqua Inc.';
const fullTitle = bareTitle ? title : `${title} — ${siteName}`;
const canonical = new URL(Astro.url.pathname, Astro.site).href.replace(
  /(?<=.)\/$/,
  ''
);
const ogImage = new URL(image, Astro.site).href;
const imageExtension = new URL(ogImage).pathname.split('.').pop()?.toLowerCase();
const ogImageType = ({ png: 'image/png', jpg: 'image/jpeg', jpeg: 'image/jpeg', webp: 'image/webp', avif: 'image/avif' } as Record<string, string>)[imageExtension ?? ''];
const ogImageAlt = imageAlt;
const linkedin = 'https://www.linkedin.com/in/ladellfuqua/';
const authorPortrait = await getImage({ src: portrait, width: 440, format: 'webp' });
const buildRevision = process.env.VERCEL_GIT_COMMIT_SHA;

// Google Analytics 4 — production only. The tag is additionally guarded at
// runtime to the live domain (see head), so it never runs in local dev or on
// the localhost preview build and cannot pollute production reporting.
const GA_ID = 'G-K7TBK1TGXX';
const enableAnalytics = import.meta.env.PROD;

// Person + Organization schema, shared site-wide (§25)
const personSchema = {
  '@context': 'https://schema.org',
  '@type': 'Person',
  '@id': new URL('/#person', Astro.site).href,
  name: 'Ladell Fuqua',
  url: Astro.site?.href,
  sameAs: [linkedin],
  jobTitle: 'Chief Operating Officer & Head of Growth',
  description: 'Ladell Fuqua is Chief Operating Officer and Head of Growth at PWX Solutions in New York. He has held media leadership roles at AOL, Condé Nast and TheStreet, and writes about work, technology and culture.',
  image: new URL(authorPortrait.src, Astro.site).href,
  knowsAbout: ['Growth strategy', 'Operations', 'Media', 'Marketing', 'Technology', 'Leadership', 'Team development'],
  homeLocation: {
    '@type': 'Place',
    name: 'New York, NY',
  },
  worksFor: {
    '@type': 'Organization',
    name: 'PWX Solutions',
    url: 'https://pwxsolutions.com/',
  },
};
const orgSchema = {
  '@context': 'https://schema.org',
  '@type': 'Organization',
  '@id': new URL('/#organization', Astro.site).href,
  name: 'Fuqua Inc.',
  url: Astro.site?.href,
};
const websiteSchema = {
  '@context': 'https://schema.org',
  '@type': 'WebSite',
  '@id': new URL('/#website', Astro.site).href,
  name: siteName,
  url: Astro.site?.href,
  publisher: { '@id': new URL('/#organization', Astro.site).href },
};
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <link rel="icon" href="/favicon.ico" sizes="16x16" />
    <link rel="icon" href="/favicon-16.png" type="image/png" sizes="16x16" />
    <link rel="icon" href="/favicon-32.png" type="image/png" sizes="32x32" />
    <link rel="icon" href="/favicon-48.png" type="image/png" sizes="48x48" />
    <link rel="icon" href="/favicon-64.png" type="image/png" sizes="64x64" />
    <link rel="icon" href="/favicon-96.png" type="image/png" sizes="96x96" />
    <link rel="icon" href="/favicon-192.png" type="image/png" sizes="192x192" />
    <link rel="icon" href="/favicon-512.png" type="image/png" sizes="512x512" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" sizes="180x180" />
    <link rel="manifest" href="/site.webmanifest" />
    <meta name="theme-color" content="#182536" />

    <title>{fullTitle}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    {noindex && <meta name="robots" content="noindex, nofollow" />}
    <meta name="author" content="Ladell Fuqua" />
    {buildRevision && <meta name="build-revision" content={buildRevision} />}

    <!-- Open Graph -->
    <meta property="og:type" content={type} />
    <meta property="og:site_name" content={siteName} />
    <meta property="og:title" content={fullTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={ogImage} />
    {ogImageType && <meta property="og:image:type" content={ogImageType} />}
    <meta property="og:image:width" content={String(imageWidth)} />
    <meta property="og:image:height" content={String(imageHeight)} />
    <meta property="og:image:alt" content={ogImageAlt} />

    <!-- Twitter -->
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={fullTitle} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImage} />
    <meta name="twitter:image:alt" content={ogImageAlt} />

    <link rel="sitemap" href="/sitemap-index.xml" />
    <link rel="alternate" type="application/rss+xml" title="Fuqua Inc. — Writing" href="/rss.xml" />

    <!-- Preserve initialization order without blocking HTML parsing or paint. -->
    <script is:inline defer src="/scripts/site-bootstrap.js"></script>
    <script is:inline defer src="/scripts/motion-readiness.js"></script>

    <script
      type="application/ld+json"
      set:html={JSON.stringify(personSchema)}
    />
    <script type="application/ld+json" set:html={JSON.stringify(orgSchema)} />
    <script
      type="application/ld+json"
      set:html={JSON.stringify(websiteSchema)}
    />

    {enableAnalytics && <script is:inline defer src="/scripts/analytics.js" data-ga-id={GA_ID}></script>}

    <slot name="head" />
  </head>
  <body class={bodyClass} data-header-tone={headerTone}>
    <SiteHeader tone={headerTone} manageScroll={manageHeaderScroll} />
    <main id="main">
      <slot />
    </main>
    <SiteFooter />
    {siteMotion && <SiteMotion />}
  </body>
</html>
