---
/** Essays & Ideas landing (/writing) — LAD-17 and LAD-30. */
import BaseLayout from '../layouts/BaseLayout.astro';
import BrandGraphic from '../components/BrandGraphic.astro';
import {
  articleHref,
  formatArticleDate,
  getPublishedArticles,
} from '../lib/articles';

// The five overlapping editorial themes (order per brief).
const themes = [
  {
    name: 'Work and Leadership',
    note: 'How people lead, build teams and find meaning in the work itself.',
  },
  {
    name: 'Identity and Belonging',
    note: 'Being seen and included — race, access, power, and who gets to belong.',
  },
  {
    name: 'Technology and Change',
    note: 'How technology reshapes what we do, and what it asks of us.',
  },
  {
    name: 'Culture and Opportunity',
    note: 'The forces that widen or narrow the paths available to people.',
  },
  {
    name: 'Personal Reflections',
    note: 'Shorter, more personal notes and observations from along the way.',
  },
];

const articles = await getPublishedArticles();
---

<BaseLayout
  title="Essays & Ideas"
  description="Essays and ideas by Ladell Fuqua on work and leadership, identity and belonging, technology and change, culture and opportunity, and personal reflections."
>
  {/* ---------- Intro ---------- */}
  <section class="section section--tight writing-hero">
    <div class="container writing-hero__inner">
      <div class="writing-hero__copy">
        <p class="eyebrow">Essays &amp; Ideas</p>
        <h1 class="writing-hero__title">Essays &amp; Ideas</h1>
        <p class="lead">
          Writing about work and leadership, identity and belonging, technology and change,
          culture and opportunity, and the experiences that connect them. A collection of
          ideas, observations, and personal reflections on how we work and live.
        </p>
      </div>
      <div class="writing-hero__art" aria-hidden="true">
        <BrandGraphic variant="motif" />
      </div>
    </div>
  </section>

  {/* ---------- Themes ---------- */}
  <section class="section section--stone writing-themes">
    <div class="container">
      <div class="section-head">
        <p class="eyebrow">The themes</p>
        <p class="writing-themes__lede">
          Five overlapping threads I keep returning to. Essays often sit where they meet.
        </p>
      </div>
      <ol class="themes" role="list">
        {
          themes.map((t) => (
            <li class="theme">
              <h2 class="theme__name">{t.name}</h2>
              <p class="theme__note">{t.note}</p>
            </li>
          ))
        }
      </ol>
    </div>
  </section>

  {/* ---------- Published articles ---------- */}
  <section class="section section--tight writing-latest">
    <div class="container">
      <p class="eyebrow writing-latest__heading">Published articles</p>
      {
        articles.length > 0 ? (
          <ul class="article-list" role="list">
            {articles.map((a) => (
              <li>
                <a href={articleHref(a)} class="article-row">
                  <time datetime={a.data.publishedAt.toISOString()}>
                    {formatArticleDate(a.data.publishedAt)}
                  </time>
                  <span class="article-row__body">
                    <span class="article-row__title">{a.data.title}</span>
                    <span class="article-row__deck">{a.data.deck}</span>
                    <span class="article-row__theme">{a.data.themes[0]}</span>
                  </span>
                </a>
              </li>
            ))}
          </ul>
        ) : (
          <p class="article-list__empty">No articles are published right now.</p>
        )
      }
    </div>
  </section>
</BaseLayout>

<style>
  /* ---------- Intro ---------- */
  .writing-hero__inner {
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(0, 0.5fr);
    align-items: center;
    gap: clamp(2rem, 1rem + 4vw, 4.5rem);
  }
  .writing-hero__title {
    margin-top: 0.5rem;
    font-size: var(--fs-2xl);
    letter-spacing: var(--tracking-tight);
    line-height: var(--lh-tight);
  }
  .writing-hero__copy .lead {
    margin-top: 1.5rem;
    max-width: 54ch;
  }
  .writing-hero__art {
    max-width: 240px;
    margin-inline: auto;
    opacity: 0.9;
  }
  @media (max-width: 52rem) {
    .writing-hero__inner {
      grid-template-columns: 1fr;
    }
    .writing-hero__art {
      display: none;
    }
  }

  /* ---------- Themes ---------- */
  .section-head {
    margin-bottom: clamp(1.75rem, 1.2rem + 2vw, 2.5rem);
  }
  .writing-themes__lede {
    margin-top: 0.75rem;
    color: var(--text);
    font-size: var(--fs-md);
    max-width: 48ch;
  }
  .themes {
    list-style: none;
    margin: 0;
    padding: 0;
    counter-reset: theme;
  }
  .theme {
    counter-increment: theme;
    display: grid;
    grid-template-columns: minmax(0, 20rem) minmax(0, 1fr);
    gap: clamp(0.75rem, 0.5rem + 2vw, 3rem);
    align-items: baseline;
    padding-block: clamp(1.25rem, 1rem + 1vw, 1.9rem);
    border-top: 1px solid var(--line);
  }
  .theme:last-child {
    border-bottom: 1px solid var(--line);
  }
  .theme__name {
    position: relative;
    font-size: var(--fs-lg);
    font-weight: var(--weight-semi);
    color: var(--heading);
    letter-spacing: var(--tracking-tight);
    padding-left: 2.6rem;
  }
  .theme__name::before {
    content: counter(theme, decimal-leading-zero);
    position: absolute;
    left: 0;
    top: 0.35em;
    font-family: var(--font-sans);
    font-size: 0.8rem;
    font-weight: var(--weight-semi);
    letter-spacing: 0.08em;
    color: var(--accent);
  }
  .theme__note {
    color: var(--text);
    font-size: var(--fs-base);
    max-width: 46ch;
  }
  @media (max-width: 44rem) {
    .theme {
      grid-template-columns: 1fr;
      gap: 0.5rem;
    }
    .theme__note {
      padding-left: 2.6rem;
    }
  }

  /* ---------- Published articles ---------- */
  .writing-latest__heading {
    margin-bottom: 1rem;
  }
  .article-list {
    list-style: none;
    margin: 0;
    padding: 0;
    border-top: 1px solid var(--line);
  }
  .article-list li {
    border-bottom: 1px solid var(--line);
  }
  .article-row {
    display: grid;
    grid-template-columns: 9rem minmax(0, 1fr);
    gap: clamp(1rem, 0.5rem + 2vw, 2.5rem);
    padding-block: 1.5rem;
    color: inherit;
  }
  .article-row:hover {
    text-decoration: none;
  }
  .article-row time {
    padding-top: 0.25rem;
    color: var(--text-muted);
    font-size: var(--fs-sm);
  }
  .article-row__body,
  .article-row__title,
  .article-row__deck,
  .article-row__theme {
    display: block;
  }
  .article-row__title {
    color: var(--heading);
    font-family: var(--font-serif);
    font-size: var(--fs-lg);
    font-weight: var(--weight-semi);
  }
  .article-row__deck {
    max-width: 52ch;
    margin-top: 0.45rem;
    color: var(--text);
    font-family: var(--font-serif);
    font-style: italic;
  }
  .article-row__theme {
    margin-top: 0.75rem;
    color: var(--accent);
    font-size: 0.7rem;
    font-weight: var(--weight-semi);
    letter-spacing: 0.12em;
    text-transform: uppercase;
  }
  .article-list__empty {
    padding-block: 1.5rem;
    border-block: 1px solid var(--line);
    color: var(--text-muted);
  }
  @media (prefers-reduced-motion: no-preference) {
    .article-row__body {
      transition: transform var(--dur) var(--ease);
    }
    .article-row:hover .article-row__body,
    .article-row:focus-visible .article-row__body {
      transform: translateX(0.5rem);
    }
  }
  @media (max-width: 36rem) {
    .article-row {
      grid-template-columns: 1fr;
      gap: 0.6rem;
    }
  }
</style>
