---
/**
 * BaseLayout — document shell, SEO, structured data. (§25)
 */
import '../styles/global.css';
import SiteHeader from '../components/SiteHeader.astro';
import SiteFooter from '../components/SiteFooter.astro';
import SiteMotion from '../components/SiteMotion.astro';

interface Props {
  title: string;
  description: string;
  /** Path-relative or absolute OG image; defaults to site card. */
  image?: string;
  /** Override the document type for structured data on article pages. */
  type?: 'website' | 'article';
  /** Suppress " — Fuqua Inc." title suffix (e.g. homepage). */
  bareTitle?: boolean;
  /** Page-level header treatment. */
  headerTone?: 'light' | 'dark';
  /** Let the shared header own its scroll-state transition. */
  manageHeaderScroll?: boolean;
  /** Render the document-level progress/footer motion controller. */
  siteMotion?: boolean;
  /** Optional page-level body class for template-specific composition. */
  bodyClass?: string;
  noindex?: boolean;
}

const {
  title,
  description,
  image = '/og-home-2026.png',
  type = 'website',
  bareTitle = false,
  headerTone = 'light',
  manageHeaderScroll = true,
  siteMotion = true,
  bodyClass,
  noindex = false,
} = Astro.props;

const siteName = 'Fuqua Inc.';
const fullTitle = bareTitle ? title : `${title} — ${siteName}`;
const canonical = new URL(Astro.url.pathname, Astro.site).href.replace(
  /(?<=.)\/$/,
  ''
);
const ogImage = new URL(image, Astro.site).href;
const ogImageAlt = 'Fuqua Inc. — Ladell Fuqua';
const linkedin = 'https://www.linkedin.com/in/ladellfuqua/';

// Google Analytics 4 — production only. The tag is additionally guarded at
// runtime to the live domain (see head), so it never runs in local dev or on
// the localhost preview build and cannot pollute production reporting.
const GA_ID = 'G-K7TBK1TGXX';
const enableAnalytics = import.meta.env.PROD;

// Person + Organization schema, shared site-wide (§25)
const personSchema = {
  '@context': 'https://schema.org',
  '@type': 'Person',
  name: 'Ladell Fuqua',
  url: Astro.site?.href,
  sameAs: [linkedin],
  jobTitle: 'Growth and Operating Executive',
  worksFor: {
    '@type': 'Organization',
    name: 'Fuqua Inc.',
    url: Astro.site?.href,
  },
};
const orgSchema = {
  '@context': 'https://schema.org',
  '@type': 'Organization',
  name: 'Fuqua Inc.',
  url: Astro.site?.href,
  sameAs: [linkedin],
};
const websiteSchema = {
  '@context': 'https://schema.org',
  '@type': 'WebSite',
  name: siteName,
  url: Astro.site?.href,
};
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <link rel="icon" href="/favicon.ico" sizes="16x16" />
    <link rel="icon" href="/favicon-16.png" type="image/png" sizes="16x16" />
    <link rel="icon" href="/favicon-32.png" type="image/png" sizes="32x32" />
    <link rel="icon" href="/favicon-48.png" type="image/png" sizes="48x48" />
    <link rel="icon" href="/favicon-64.png" type="image/png" sizes="64x64" />
    <link rel="icon" href="/favicon-96.png" type="image/png" sizes="96x96" />
    <link rel="icon" href="/favicon-192.png" type="image/png" sizes="192x192" />
    <link rel="icon" href="/favicon-512.png" type="image/png" sizes="512x512" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" sizes="180x180" />
    <link rel="manifest" href="/site.webmanifest" />
    <meta name="theme-color" content="#182536" />

    <title>{fullTitle}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    {noindex && <meta name="robots" content="noindex, nofollow" />}
    <meta name="author" content="Ladell Fuqua" />

    <!-- Open Graph -->
    <meta property="og:type" content={type} />
    <meta property="og:site_name" content={siteName} />
    <meta property="og:title" content={fullTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content={ogImageAlt} />

    <!-- Twitter -->
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={fullTitle} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImage} />
    <meta name="twitter:image:alt" content={ogImageAlt} />

    <link rel="sitemap" href="/sitemap-index.xml" />

    <script is:inline src="/scripts/site-bootstrap.js"></script>
    <script is:inline src="/scripts/motion-readiness.js"></script>

    <script
      type="application/ld+json"
      set:html={JSON.stringify(personSchema)}
    />
    <script type="application/ld+json" set:html={JSON.stringify(orgSchema)} />
    <script
      type="application/ld+json"
      set:html={JSON.stringify(websiteSchema)}
    />

    {enableAnalytics && <script is:inline src="/scripts/analytics.js" data-ga-id={GA_ID}></script>}

    <slot name="head" />
  </head>
  <body class={bodyClass} data-header-tone={headerTone}>
    <SiteHeader tone={headerTone} manageScroll={manageHeaderScroll} />
    <main id="main">
      <slot />
    </main>
    <SiteFooter />
    {siteMotion && <SiteMotion />}
  </body>
</html>
