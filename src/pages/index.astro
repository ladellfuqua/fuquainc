---
import BaseLayout from '../layouts/BaseLayout.astro';
import BrandGraphic from '../components/BrandGraphic.astro';
import HomepageHero from '../components/HomepageHero.astro';
import { getImage } from 'astro:assets';
import heroPortrait from '../assets/ladell-home-portrait.png';

const heroPortraitWidths = [280, 320, 400, 560];
const heroPortraitSizes = '(max-width: 56.24rem) min(72vw, 22rem), 20rem';
const heroPortraitAvif = await Promise.all(
  heroPortraitWidths.map((width) =>
    getImage({ src: heroPortrait, width, format: 'avif' })
  )
);
const heroPortraitSrcset = heroPortraitAvif
  .map((image, index) => `${image.src} ${heroPortraitWidths[index]}w`)
  .join(', ');

// Areas of Focus (§17-19) — six areas; Operational Strategy removed, woven in elsewhere.
const focus = [
  {
    title: 'Growth Strategy',
    body: 'Identifying opportunities for sustainable audience, customer and revenue growth.',
  },
  {
    title: 'Audience & Customer Growth',
    body: 'Understanding behavior and building stronger relationships across the customer lifecycle.',
  },
  {
    title: 'Marketing & Media',
    body: 'Connecting brand, performance, content, audience and channel strategy.',
  },
  {
    title: 'Digital, Technology & AI',
    body: 'Exploring how technology can improve experiences, capabilities and business performance.',
  },
  {
    title: 'Building Growth Teams',
    body: 'Bringing together people, capabilities and disciplines around shared growth objectives.',
  },
  {
    title: 'Business Transformation',
    body: 'Helping organizations adapt their capabilities, structures and ways of working as the business changes.',
  },
];

// Growth-team principles (§21) — restrained typography, not cards.
const teamPrinciples = [
  {
    title: 'Clear Mandate',
    body: 'A team needs one outcome it is collectively responsible for — not a stack of functional targets that quietly compete with one another.',
  },
  {
    title: 'Cross-Functional by Design',
    body: 'Growth problems do not respect the org chart. The team is assembled around the problem, with the people who can actually move it in the room from the start.',
  },
  {
    title: 'Accountability Without Bureaucracy',
    body: 'Structure should make ownership and progress obvious — who decides, and what "done" means — without adding process that slows the work it was meant to support.',
  },
];

// How I Think (LAD-28) — one typographic block; no icons or illustrations.
const principles = [
  {
    number: '01',
    title: 'Growth is a system',
    body: 'It happens when ideas, people, technology and opportunity connect — rarely inside one department.',
  },
  {
    number: '02',
    title: 'Teams outperform heroes',
    body: 'Shared goals, clear decision rights and enough trust beat any org chart.',
  },
  {
    number: '03',
    title: 'Clarity is the work',
    body: "Most stalled work isn't a strategy problem or a talent problem — no one agrees on what matters or who decides.",
  },
];

// Latest Writing (§16) — wired to real content later. Elegant single-feature state, never empty cards.
const featured: {
  category: string;
  title: string;
  deck: string;
  date: string;
  readingTime: string;
  href: string;
} | null = null;
---

<BaseLayout
  title="Fuqua Inc."
  description="Fuqua Inc. is the platform of Ladell Fuqua: ideas and work on building growth by connecting ideas, people, technology and opportunity."
  bareTitle={true}
  headerTone="dark"
>
  <link
    slot="head"
    rel="preload"
    as="image"
    type="image/avif"
    href={heroPortraitAvif[1].src}
    imagesrcset={heroPortraitSrcset}
    imagesizes={heroPortraitSizes}
    fetchpriority="high"
  />

  <HomepageHero />

  {/* ---------- About / bio (LAD-29) ---------- */}
  <section class="section bio" aria-labelledby="bio-heading">
    <div class="container bio__inner">
      <h2 id="bio-heading" class="eyebrow bio__heading">About</h2>
      <p class="bio__copy" data-bio-reveal>
        <strong>Ladell Fuqua</strong> is Chief Operating Officer at&nbsp;
        <strong>PWX Solutions</strong>. Three decades in media &mdash; Condé Nast,
        AOL, TheStreet. Known for creating clarity, building accountability, and
        developing teams that deliver results.
      </p>
      <blockquote class="bio__quote" data-bio-quote>
        <span class="bio__quote-line"><span>Good strategy sets the direction;{' '}</span></span>
        <span class="bio__quote-line"><span>disciplined execution creates the outcome.</span></span>
      </blockquote>
    </div>
  </section>

  {/* ---------- Latest Writing — moved directly below hero (§16) ---------- */}
  <section class="section section--tight writing">
    <div class="container">
      <div class="writing__head">
        <p class="eyebrow">Latest Writing</p>
        <a href="/writing" class="arrow-link writing__all">
          View all writing <span class="arrow" aria-hidden="true">&rarr;</span>
        </a>
      </div>

      {
        featured ? (
          <a href={featured.href} class="feature">
            <div class="feature__art">
              <BrandGraphic variant="motif" />
            </div>
            <div class="feature__body">
              <p class="feature__meta">
                <span class="feature__cat">{featured.category}</span>
                <span class="feature__dot" aria-hidden="true">
                  &middot;
                </span>
                <span>{featured.date}</span>
                <span class="feature__dot" aria-hidden="true">
                  &middot;
                </span>
                <span>{featured.readingTime}</span>
              </p>
              <h2 class="feature__title">{featured.title}</h2>
              <p class="feature__deck">{featured.deck}</p>
              <span class="arrow-link">
                Read article <span class="arrow" aria-hidden="true">&rarr;</span>
              </span>
            </div>
          </a>
        ) : (
          <div class="feature feature--coming">
            <div class="feature__art" aria-hidden="true">
              <BrandGraphic variant="motif" />
            </div>
            <div class="feature__body">
              <p class="feature__meta">
                <span class="feature__cat">Essays &amp; ideas</span>
              </p>
              <p class="feature__title feature__title--soft">
                Writing about work and leadership, identity and belonging,
                technology and change, and culture and opportunity.
              </p>
              <p class="feature__deck">
                The first essays are on the way. This is where new writing will
                live &mdash; ideas, observations and personal reflections on how
                we work and live.
              </p>
            </div>
          </div>
        )
      }
    </div>
  </section>

  {/* ---------- Areas of Focus (§17-19) ---------- */}
  <section class="section section--stone focus">
    <div class="container">
      <div class="section-head">
        <p class="eyebrow">Areas of Focus</p>
      </div>
      <ul class="focus__grid" role="list">
        {
          focus.map((area) => (
            <li class="focus__item">
              <h2 class="focus__title">{area.title}</h2>
              <p class="focus__body">{area.body}</p>
            </li>
          ))
        }
      </ul>
    </div>
  </section>

  {/* ---------- Building Growth Teams (§20-22) ---------- */}
  <section class="section teams">
    <div class="teams__art" aria-hidden="true">
      <BrandGraphic variant="motif" />
    </div>
    <div class="container teams__inner">
      <div class="teams__lead">
        <p class="eyebrow">Building Growth Teams</p>
        <p class="lead">
          Growth is rarely one team's job. It happens when marketing, product,
          technology and commercial leadership pull in the same direction — and
          stalls when each optimizes for its own scorecard instead of a shared
          one.
        </p>
        <p>
          Much of my work sits in that connective space: giving a group of
          talented, specialized people a single objective they can organize
          around, then removing the ambiguity — about ownership, priorities and
          how decisions get made — that quietly slows most growth efforts down.
        </p>
        <p>
          In my experience, the hard part is rarely the strategy itself. It is
          building the conditions in which a cross-functional team can move
          quickly without losing coordination: shared goals, clear decision
          rights, and enough trust that people surface problems early rather
          than protect their corner.
        </p>
      </div>

      <p class="teams__pull">
        The best strategy in the world does not matter if nobody can figure out
        how to make it happen.
      </p>

      <ol class="teams__principles" role="list">
        {
          teamPrinciples.map((p) => (
            <li class="teams__principle">
              <h3 class="teams__principle-title">{p.title}</h3>
              <p class="teams__principle-body">{p.body}</p>
            </li>
          ))
        }
      </ol>
    </div>
  </section>

  {/* ---------- How I Think (§23) ---------- */}
  <section class="section section--navy pov">
    <div class="pov__field" aria-hidden="true">
      <BrandGraphic variant="field" />
    </div>
    <div class="container pov__inner">
      <h2 class="eyebrow pov__heading">How I Think</h2>
      <ol class="pov__panels" role="list">
        {
          principles.map((principle) => (
            <li class="pov__panel">
              <span class="pov__number" aria-hidden="true">
                {principle.number}
              </span>
              <h3 class="pov__title">{principle.title}</h3>
              <p class="pov__body">{principle.body}</p>
            </li>
          ))
        }
      </ol>
    </div>
  </section>

  {/* ---------- Connect / LinkedIn (§28) ---------- */}
  <section class="section--tight connect">
    <div class="container connect__inner">
      <p class="connect__text">
        I also share ideas and join conversations on LinkedIn.
      </p>
      <a
        href="https://www.linkedin.com/in/ladellfuqua/"
        class="arrow-link"
        target="_blank"
        rel="me noopener"
      >
        Connect on LinkedIn <span class="arrow" aria-hidden="true">&rarr;</span>
      </a>
    </div>
  </section>
</BaseLayout>

<style>
  /* ---------- Section head ---------- */
  .section-head {
    margin-bottom: clamp(1.75rem, 1.2rem + 2vw, 2.5rem);
  }

  /* ---------- Latest Writing / featured ---------- */
  .writing__head {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    gap: 1rem;
    flex-wrap: wrap;
    margin-bottom: clamp(1.5rem, 1.1rem + 1.5vw, 2.25rem);
  }
  .writing__all {
    font-size: var(--fs-sm);
  }
  .feature {
    display: grid;
    grid-template-columns: minmax(0, 0.9fr) minmax(0, 1.1fr);
    gap: clamp(1.5rem, 1rem + 4vw, 4rem);
    align-items: center;
    padding-top: clamp(1.5rem, 1rem + 2vw, 2.5rem);
    border-top: 1px solid var(--line);
    color: inherit;
  }
  a.feature:hover {
    text-decoration: none;
  }
  .feature__art {
    background: var(--c-ivory-deep);
    border: 1px solid var(--line);
    border-radius: var(--radius);
    padding: clamp(1.5rem, 1rem + 4vw, 3rem);
    aspect-ratio: 16 / 10;
    display: flex;
    align-items: center;
    justify-content: center;
    overflow: hidden;
  }
  .section--stone .feature__art {
    background: var(--surface);
  }
  .feature__meta {
    display: flex;
    align-items: center;
    gap: 0.6rem;
    font-size: var(--fs-sm);
    color: var(--text-muted);
    margin-bottom: 0.9rem;
  }
  .feature__cat {
    color: var(--accent);
    font-weight: var(--weight-medium);
    letter-spacing: 0.02em;
  }
  .feature__dot {
    color: var(--line-strong);
  }
  .feature__title {
    font-size: var(--fs-xl);
    letter-spacing: var(--tracking-tight);
    max-width: 20ch;
  }
  .feature__title--soft {
    font-weight: var(--weight-semi);
    color: var(--heading);
  }
  .feature__deck {
    margin-top: 1rem;
    color: var(--text);
    max-width: 46ch;
  }
  a.feature .arrow-link {
    display: inline-flex;
    margin-top: 1.4rem;
  }
  @media (max-width: 48rem) {
    .feature {
      grid-template-columns: 1fr;
    }
    .feature__art {
      order: -1;
    }
  }

  /* ---------- Areas of Focus grid ---------- */
  .focus__grid {
    list-style: none;
    padding: 0;
    margin: 0;
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 0 clamp(1.25rem, 1rem + 1.5vw, 2.5rem);
  }
  .focus__item {
    padding-block: clamp(1.4rem, 1rem + 1.4vw, 2rem);
    border-top: 1px solid var(--line);
  }
  .focus__title {
    font-size: var(--fs-lg);
    font-weight: var(--weight-semi);
    color: var(--heading);
    letter-spacing: var(--tracking-tight);
  }
  .focus__body {
    margin-top: 0.7rem;
    color: var(--text);
    font-size: var(--fs-base);
    max-width: 34ch;
  }
  @media (max-width: 60rem) {
    .focus__grid {
      grid-template-columns: repeat(2, 1fr);
    }
  }
  @media (max-width: 40rem) {
    .focus__grid {
      grid-template-columns: 1fr;
    }
    .focus__body {
      max-width: var(--measure);
    }
  }

  /* ---------- Building Growth Teams ---------- */
  .teams {
    position: relative;
    overflow: hidden;
  }
  .teams__art {
    position: absolute;
    top: clamp(-2rem, -1rem - 2vw, 0rem);
    right: calc(-1 * clamp(2rem, 1rem + 4vw, 6rem));
    width: clamp(180px, 26vw, 340px);
    opacity: 0.9;
    pointer-events: none;
  }
  .teams__inner {
    position: relative;
  }
  .teams__lead {
    max-width: 52ch;
  }
  .teams__lead > * + * {
    margin-top: 1.2rem;
  }
  .teams__pull {
    font-family: var(--font-serif);
    font-size: var(--fs-xl);
    line-height: var(--lh-snug);
    color: var(--heading);
    letter-spacing: var(--tracking-tight);
    max-width: 24ch;
    margin-block: clamp(2.5rem, 2rem + 3vw, 4rem);
  }
  .teams__principles {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: clamp(1.25rem, 1rem + 2vw, 2.75rem);
    counter-reset: tp;
  }
  .teams__principle {
    counter-increment: tp;
    padding-top: 1.1rem;
    border-top: 2px solid var(--accent);
  }
  .teams__principle-title {
    font-size: var(--fs-md);
    font-weight: var(--weight-semi);
    color: var(--heading);
  }
  .teams__principle-body {
    margin-top: 0.6rem;
    color: var(--text);
    font-size: var(--fs-base);
  }
  @media (max-width: 48rem) {
    .teams__principles {
      grid-template-columns: 1fr;
      gap: 0;
    }
    .teams__principle {
      padding-block: 1.1rem;
    }
    .teams__principle + .teams__principle {
      border-top-width: 1px;
    }
    .teams__art {
      width: 150px;
      right: calc(-1 * var(--gutter));
      opacity: 0.5;
    }
  }

  /* ---------- How I Think ---------- */
  .pov {
    position: relative;
    overflow: hidden;
  }
  .pov__field {
    position: absolute;
    inset: 0;
    pointer-events: none;
    opacity: 0.18;
  }
  .pov__field :global(.bg-graphic) {
    width: 100%;
    height: 100%;
  }
  .pov__inner {
    position: relative;
  }
  .pov__heading {
    margin-bottom: clamp(2rem, 1.5rem + 2vw, 3.25rem);
  }
  .pov__panels {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    list-style: none;
    padding: 0;
    margin: 0;
    border-block: 1px solid var(--on-dark-line);
  }
  .pov__panel {
    position: relative;
    min-height: 19rem;
    padding: clamp(2rem, 1.5rem + 2.2vw, 3rem);
    transition: background-color var(--dur) var(--ease);
  }
  .pov__panel + .pov__panel {
    border-left: 1px solid var(--on-dark-line);
  }
  .pov__panel:hover {
    background: var(--c-navy-soft);
  }
  .pov__number {
    display: block;
    font-size: 0.8rem;
    font-weight: var(--weight-semi);
    letter-spacing: 0.14em;
    color: #c9adc0;
    margin-bottom: clamp(2rem, 1.5rem + 1vw, 2.75rem);
  }
  .pov__title {
    max-width: 13ch;
    color: var(--on-dark);
    font-size: clamp(1.55rem, 1.25rem + 1vw, 2rem);
    line-height: 1.14;
  }
  .pov__body {
    max-width: 31ch;
    margin-top: 1.15rem;
    color: #c6cdd5;
    font-size: clamp(0.98rem, 0.94rem + 0.16vw, 1.08rem);
    line-height: 1.65;
  }
  @media (max-width: 52rem) {
    .pov__panels {
      grid-template-columns: 1fr;
    }
    .pov__panel {
      min-height: 0;
    }
    .pov__panel + .pov__panel {
      border-top: 1px solid var(--on-dark-line);
      border-left: 0;
    }
    .pov__number {
      margin-bottom: 1.5rem;
    }
    .pov__title,
    .pov__body {
      max-width: var(--measure-narrow);
    }
  }

  /* ---------- About / bio ---------- */
  .bio {
    background: var(--bg);
    overflow: hidden;
  }
  .bio__inner {
    padding-block: clamp(0.5rem, 1vw, 1rem);
  }
  .bio__heading {
    margin-bottom: clamp(1.5rem, 1.1rem + 1.4vw, 2rem);
  }
  .bio__copy {
    max-width: 30em;
    color: var(--text);
    font-family: var(--font-serif);
    font-size: clamp(1.3rem, 1.08rem + 0.8vw, 1.7rem);
    line-height: 1.55;
  }
  .bio__copy strong {
    color: var(--c-navy);
    font-weight: var(--weight-semi);
  }
  .bio__quote {
    max-width: 36em;
    margin-top: clamp(2rem, 1.6rem + 1.4vw, 2.5rem);
    padding-left: 1.35rem;
    border-left: 2px solid var(--accent);
    color: var(--text);
    font-family: var(--font-serif);
    font-size: clamp(1rem, 0.96rem + 0.14vw, 1.06rem);
    font-style: italic;
    line-height: 1.55;
  }
  .bio__quote-line {
    display: block;
  }

  @media (prefers-reduced-motion: no-preference) {
    :global(html[data-motion='enabled']) .bio--prepared .bio__word {
      display: inline-block;
      opacity: 0;
      transform: translateY(0.875rem);
      transition:
        opacity 620ms var(--ease),
        transform 620ms var(--ease);
      transition-delay: calc(var(--word-index) * 26ms);
    }
    :global(html[data-motion='enabled']) .bio--prepared.bio--visible .bio__word {
      opacity: 1;
      transform: none;
    }
    :global(html[data-motion='enabled']) .bio--prepared .bio__quote-line {
      overflow: hidden;
    }
    :global(html[data-motion='enabled']) .bio--prepared .bio__quote-line > span {
      display: block;
      transform: translateY(115%);
      transition: transform 820ms var(--ease);
    }
    :global(html[data-motion='enabled'])
      .bio--prepared.bio--visible
      .bio__quote-line
      > span {
      transform: none;
    }
    :global(html[data-motion='enabled'])
      .bio--prepared.bio--visible
      .bio__quote-line:nth-child(2)
      > span {
      transition-delay: 110ms;
    }
  }

  /* ---------- Connect ---------- */
  .connect {
    background: var(--bg);
    border-top: 1px solid var(--line);
  }
  .connect__inner {
    display: flex;
    align-items: center;
    justify-content: space-between;
    flex-wrap: wrap;
    gap: 0.75rem 2rem;
  }
  .connect__text {
    color: var(--text);
    font-size: var(--fs-md);
    max-width: none;
    margin: 0;
  }
</style>

<script>
  const bio = document.querySelector<HTMLElement>('.bio');
  const bioCopy = bio?.querySelector<HTMLElement>('[data-bio-reveal]');

  if (
    bio &&
    bioCopy &&
    document.documentElement.dataset.motion === 'enabled' &&
    'IntersectionObserver' in window
  ) {
    const walker = document.createTreeWalker(bioCopy, NodeFilter.SHOW_TEXT);
    const textNodes: Text[] = [];
    let node: Node | null;

    while ((node = walker.nextNode())) textNodes.push(node as Text);

    let wordIndex = 0;
    textNodes.forEach((textNode) => {
      const fragment = document.createDocumentFragment();
      textNode.textContent?.split(/(\s+)/).forEach((token) => {
        if (!token.trim()) {
          fragment.appendChild(document.createTextNode(token));
          return;
        }

        const word = document.createElement('span');
        word.className = 'bio__word';
        word.style.setProperty('--word-index', String(wordIndex));
        word.textContent = token;
        wordIndex += 1;
        fragment.appendChild(word);
      });
      textNode.replaceWith(fragment);
    });

    bio.classList.add('bio--prepared');
    const observer = new IntersectionObserver(
      ([entry]) => {
        if (!entry?.isIntersecting) return;
        bio.classList.add('bio--visible');
        observer.disconnect();
      },
      { threshold: 0.16, rootMargin: '0px 0px -6% 0px' }
    );
    observer.observe(bio);
  }
</script>
