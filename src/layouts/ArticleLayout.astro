---
import BaseLayout from './BaseLayout.astro';
import {
  articleHref,
  formatArticleDate,
  getPublishedArticles,
  selectRelatedArticles,
  type ArticleEntry,
} from '../lib/articles';

interface Props {
  article: ArticleEntry;
}

const { article } = Astro.props;
const { title, deck, summary, publishedAt, themes, image } = article.data;
const theme = themes[0];
const publishedArticles = await getPublishedArticles();
const relatedArticles = selectRelatedArticles(article, publishedArticles);
const canonicalUrl = new URL(articleHref(article), Astro.site).href;
const linkedInShareUrl = `https://www.linkedin.com/sharing/share-offsite/?url=${encodeURIComponent(canonicalUrl)}`;
const publishedDate = new Intl.DateTimeFormat('en-US', {
  month: 'long',
  day: 'numeric',
  year: 'numeric',
  timeZone: 'UTC',
}).format(publishedAt);
const articleSchema = {
  '@context': 'https://schema.org',
  '@type': 'Article',
  headline: title,
  description: summary,
  datePublished: publishedAt.toISOString(),
  mainEntityOfPage: canonicalUrl,
  author: {
    '@type': 'Person',
    name: 'Ladell Fuqua',
    url: 'https://fuquainc.com/about',
  },
};
---

<BaseLayout
  title={title}
  description={summary}
  image={image}
  type="article"
  headerTone="dark"
  manageHeaderScroll={false}
  siteMotion={false}
  bodyClass="article-page"
>
  <script slot="head" type="application/ld+json" set:html={JSON.stringify(articleSchema)} />

  <div class="article-progress" data-article-progress aria-hidden="true"></div>

  <section class="article-shelf" aria-label="Article details">
    <span class="article-shelf__wash" data-shelf-wash aria-hidden="true"></span>
    <svg
      class="article-shelf__lines"
      data-shelf-lines
      viewBox="0 0 1440 260"
      preserveAspectRatio="xMidYMid slice"
      aria-hidden="true"
    >
      <line x1="880" y1="380" x2="1560" y2="-160"></line>
      <line x1="980" y1="400" x2="1660" y2="-140"></line>
    </svg>
    <div class="container article-shelf__row">
      <p class="article-shelf__breadcrumb">
        <a href="/writing">Writing</a>
        <span aria-hidden="true">/</span>
        <span>{theme}</span>
      </p>
      <time datetime={publishedAt.toISOString()}>{publishedDate}</time>
    </div>
  </section>

  <div class="article-stage">
    <aside class="article-rail" data-article-rail aria-label="Share this article">
      <div class="article-rail__inner">
        <span class="article-rail__label">Share</span>
        <button type="button" data-copy-link title="Copy link" aria-label="Copy link to this article">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" aria-hidden="true">
            <path d="M10 13a5 5 0 0 0 7.5.5l3-3a5 5 0 0 0-7-7l-1.7 1.7"></path>
            <path d="M14 11a5 5 0 0 0-7.5-.5l-3 3a5 5 0 0 0 7 7l1.7-1.7"></path>
          </svg>
        </button>
        <a
          href={linkedInShareUrl}
          target="_blank"
          rel="noopener noreferrer"
          title="Share on LinkedIn"
          aria-label="Share on LinkedIn (opens in a new window)"
        >
          <svg viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
            <path d="M4.98 3.5A2.5 2.5 0 1 0 5 8.5a2.5 2.5 0 0 0 0-5zM3 9.5h4V21H3zM9.5 9.5h3.8v1.6h.05c.53-.95 1.83-1.95 3.77-1.95C21 9.15 22 11.3 22 14.3V21h-4v-6c0-1.45-.03-3.3-2.05-3.3-2.05 0-2.37 1.57-2.37 3.2V21h-4z"></path>
          </svg>
        </a>
        <button type="button" data-print-article title="Print" aria-label="Print this article">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
            <path d="M6 9V3h12v6"></path>
            <path d="M6 18H4a2 2 0 0 1-2-2v-5a2 2 0 0 1 2-2h16a2 2 0 0 1 2 2v5a2 2 0 0 1-2 2h-2"></path>
            <path d="M6 14h12v7H6z"></path>
          </svg>
        </button>
      </div>
    </aside>

    <article class="article-paper" data-article-paper>
      <header class="article-column article-head">
        <p class="article-kicker article-reveal">{theme}</p>
        <h1 class="article-title article-reveal">{title}</h1>
        <p class="article-dek article-reveal">{deck}</p>

        <div class="article-byline article-reveal">
          <div class="article-byline__author">
            <span class="article-avatar article-avatar--small" aria-hidden="true">LF</span>
            <span>
              <span class="article-byline__name">Ladell Fuqua</span>
              <time datetime={publishedAt.toISOString()}>{publishedDate}</time>
            </span>
          </div>
          <div class="article-byline__actions">
            <a class="article-pill article-pill--back" href="/writing">
              <svg viewBox="0 0 18 10" fill="none" stroke="currentColor" stroke-width="1.6" aria-hidden="true">
                <path d="M17 5H1M1 5l4-4M1 5l4 4"></path>
              </svg>
              All articles
            </a>
            <button class="article-pill" type="button" data-copy-link>
              <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" aria-hidden="true">
                <path d="M10 13a5 5 0 0 0 7.5.5l3-3a5 5 0 0 0-7-7l-1.7 1.7"></path>
                <path d="M14 11a5 5 0 0 0-7.5-.5l-3 3a5 5 0 0 0 7 7l1.7-1.7"></path>
              </svg>
              Copy link
            </button>
          </div>
        </div>
      </header>

      <div class="article-column article-body" data-article-body>
        <slot />

        <div class="article-end article-reveal" aria-hidden="true"></div>
      </div>

      <div class="article-column article-paper__tail">
        <a class="article-backlink" href="/writing">
          <svg viewBox="0 0 18 10" fill="none" stroke="currentColor" stroke-width="1.5" aria-hidden="true">
            <path d="M17 5H1M1 5l4-4M1 5l4 4"></path>
          </svg>
          All articles
        </a>
      </div>
    </article>
  </div>

  {
    relatedArticles.length > 0 && (
      <section class="more-writing" aria-labelledby="more-writing-title">
        <div class="container">
          <div class="more-writing__head article-reveal">
            <h2 id="more-writing-title">More writing</h2>
            <a href="/writing">All articles <span aria-hidden="true">&rarr;</span></a>
          </div>
          <div class="more-writing__grid" style={`--related-count:${relatedArticles.length}`}>
            {relatedArticles.map((related, index) => (
              <article class="more-writing__item article-reveal" style={`--reveal-delay:${Math.min(index, 2) * 70}ms`}>
                <p>{related.data.themes[0]}</p>
                <h3><a href={articleHref(related)}>{related.data.title}</a></h3>
                <p>{related.data.deck}</p>
                <time datetime={related.data.publishedAt.toISOString()}>{formatArticleDate(related.data.publishedAt)}</time>
              </article>
            ))}
          </div>
        </div>
      </section>
    )
  }

  <div class="article-toast" data-article-toast role="status" aria-live="polite">Link copied</div>
</BaseLayout>

<style is:global>
  .article-progress {
    position: fixed;
    z-index: 200;
    inset: 0 0 auto;
    height: 2px;
    pointer-events: none;
    background: var(--c-plum);
    transform: scaleX(var(--article-progress, 0));
    transform-origin: left;
  }

  body.article-page .site-header {
    position: fixed;
    inset: 0 0 auto;
  }
  body.article-page .site-header--dark {
    background: transparent;
    backdrop-filter: none;
    border-bottom-color: transparent;
  }
  body.article-page .site-header--dark[data-scrolled='true'] {
    background: color-mix(in srgb, var(--c-ivory) 92%, transparent);
    backdrop-filter: saturate(1.1) blur(8px);
    border-bottom-color: var(--line);
  }

  .article-shelf {
    position: relative;
    overflow: clip;
    padding-block: 6.5rem 7.375rem;
    background: var(--c-navy);
    color: #c9d0d8;
  }
  .article-shelf__wash {
    position: absolute;
    inset: -8% 0;
    pointer-events: none;
    background: radial-gradient(58% 78% at 78% 18%, rgba(127, 145, 165, 0.2), rgba(111, 83, 104, 0.13) 48%, transparent 76%);
    transform: translate3d(0, var(--shelf-wash-shift, 0), 0);
  }
  .article-shelf__lines {
    position: absolute;
    inset: -8% 0;
    width: 100%;
    height: 116%;
    pointer-events: none;
    transform: translate3d(0, var(--shelf-lines-shift, 0), 0);
  }
  .article-shelf__lines line {
    stroke: var(--c-ivory);
    stroke-width: 1.1;
    opacity: 0.1;
    vector-effect: non-scaling-stroke;
  }
  .article-shelf__lines line + line { opacity: 0.06; }
  .article-shelf__row {
    position: relative;
    z-index: 1;
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    justify-content: space-between;
    gap: 1.25rem;
  }
  .article-shelf__breadcrumb,
  .article-shelf time {
    max-width: none;
    color: #93a0b0;
    font-size: 11.5px;
    font-weight: var(--weight-semi);
    letter-spacing: 0.16em;
    text-transform: uppercase;
  }
  .article-shelf__breadcrumb { display: flex; align-items: center; gap: 0.7rem; }
  .article-shelf__breadcrumb a { color: #93a0b0; }
  .article-shelf__breadcrumb a:hover { color: var(--on-dark); }
  .article-shelf__breadcrumb span:last-child { color: #c9adc1; }
  .article-shelf time { color: #7b8896; }

  .article-stage {
    position: relative;
    z-index: 2;
    margin-top: -5.75rem;
  }
  .article-paper {
    max-width: 62.5rem;
    margin-inline: auto;
    overflow: clip;
    background: #fff;
    box-shadow: 0 1px 0 rgba(24, 37, 54, 0.06), 0 22px 60px -28px rgba(24, 37, 54, 0.34), 0 2px 10px -4px rgba(24, 37, 54, 0.1);
    padding-block: 4rem 0.5rem;
  }
  .article-column {
    width: 100%;
    max-width: 37em;
    margin-inline: auto;
    padding-inline: 2.5rem;
    font-size: 17px;
  }
  .article-kicker {
    max-width: none;
    color: var(--c-plum);
    font-size: 11.5px;
    font-weight: var(--weight-bold);
    letter-spacing: 0.17em;
    text-transform: uppercase;
  }
  .article-title {
    margin-top: 1rem;
    color: #161d26;
    font-family: var(--font-serif);
    font-size: clamp(32px, 4.6vw, 52px);
    font-weight: var(--weight-semi);
    line-height: 1.08;
    letter-spacing: -0.026em;
  }
  .article-dek {
    margin-top: 1.125rem;
    color: #5b6169;
    font-family: var(--font-serif);
    font-size: clamp(18px, 2.1vw, 22px);
    font-style: italic;
    font-weight: 300;
    line-height: 1.5;
  }
  .article-byline {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: 1.125rem;
    margin-top: 2.125rem;
    padding-block: 0.9375rem;
    border-block: 1px solid #e6e2da;
  }
  .article-byline__author { display: flex; align-items: center; gap: 0.8rem; }
  .article-avatar {
    display: grid;
    flex: none;
    width: 52px;
    height: 52px;
    place-items: center;
    border-radius: 50%;
    background: var(--c-navy);
    color: #f2efe8;
    font-family: var(--font-sans);
    font-size: 16px;
    font-weight: 650;
  }
  .article-avatar--small { width: 34px; height: 34px; font-size: 12.5px; }
  .article-byline__name,
  .article-byline time { display: block; }
  .article-byline__name { color: #161d26; font-size: 14.5px; font-weight: var(--weight-semi); line-height: 1.3; }
  .article-byline time { margin-top: 2px; color: #7d838b; font-size: 11.5px; font-weight: var(--weight-semi); letter-spacing: 0.11em; text-transform: uppercase; }
  .article-byline__actions { display: flex; flex-wrap: wrap; align-items: center; gap: 0.5rem; }
  .article-pill {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    padding: 0.44rem 0.875rem;
    border: 1px solid #e0dbd2;
    border-radius: 999px;
    background: transparent;
    color: #6d737b;
    cursor: pointer;
    font-family: var(--font-sans);
    font-size: 12px;
    font-weight: var(--weight-semi);
    letter-spacing: 0.09em;
    line-height: 1.2;
    text-transform: uppercase;
  }
  .article-pill svg { width: 13px; height: 13px; flex: none; }
  .article-pill:hover { border-color: var(--c-plum); color: var(--c-plum); text-decoration: none; }
  .article-pill--back:hover { gap: 0.75rem; }

  .article-body {
    counter-reset: article-section;
    padding-top: 2.5rem;
    color: #2b3138;
    font-family: var(--font-serif);
    font-size: 19.5px;
    line-height: 1.76;
    -webkit-font-smoothing: auto;
  }
  .article-body > p { max-width: none; margin-top: 1.15em; }
  .article-body > p:first-child { margin-top: 0; }
  .article-body > p:first-child::first-letter {
    float: left;
    padding: 0.04em 0.1em 0 0;
    color: var(--c-navy);
    font-family: var(--font-serif);
    font-size: 4.35em;
    font-weight: var(--weight-semi);
    line-height: 0.84;
  }
  .article-body strong { color: #161d26; font-weight: var(--weight-semi); }
  .article-body > h2 {
    position: relative;
    counter-increment: article-section;
    margin-top: 2.5em;
    padding-top: 1.1em;
    color: #161d26;
    font-family: var(--font-sans);
    font-size: 16px;
    font-weight: var(--weight-bold);
    letter-spacing: 0.02em;
    line-height: 1.35;
  }
  .article-body > h2::before {
    content: counter(article-section, decimal-leading-zero);
    margin-right: 0.6em;
    color: var(--c-plum);
    font-size: 13px;
    font-variant-numeric: tabular-nums;
    font-weight: var(--weight-bold);
    letter-spacing: 0.1em;
  }
  .article-body > h2::after {
    content: '';
    position: absolute;
    inset: 0 0 auto;
    height: 1px;
    background: #e6e2da;
    transform-origin: left;
  }
  .article-body > ul,
  .article-body > ol { margin-top: 1.15em; padding: 0; list-style: none; }
  .article-body li { position: relative; margin-top: 0.72em; padding-left: 1.5em; }
  .article-body > ul > li::before {
    content: '';
    position: absolute;
    top: 0.72em;
    left: 0.1em;
    width: 6px;
    height: 6px;
    border-radius: 50%;
    background: var(--c-plum);
  }
  .article-body > ol { counter-reset: article-list; }
  .article-body > ol > li { counter-increment: article-list; }
  .article-body > ol > li::before {
    content: counter(article-list);
    position: absolute;
    top: 0.06em;
    left: 0;
    color: var(--c-plum);
    font-family: var(--font-sans);
    font-size: 12px;
    font-weight: var(--weight-bold);
    letter-spacing: 0.04em;
  }
  .article-body > ol:has(> li:nth-child(3)) {
    margin-block: 2.3em 2em;
    padding: 1.5rem 1.625rem;
    border: 1px solid #e6e2da;
    border-left: 2px solid var(--c-plum);
    background: #faf9f6;
  }
  .article-body > ol:has(> li:nth-child(3))::before {
    content: 'Key points';
    display: block;
    margin-bottom: 0.75rem;
    color: var(--c-plum);
    font-family: var(--font-sans);
    font-size: 11px;
    font-weight: var(--weight-bold);
    letter-spacing: 0.17em;
    text-transform: uppercase;
  }
  .article-body > ol:has(> li:nth-child(3)) > li { font-size: 17.5px; line-height: 1.55; }
  .article-body blockquote {
    margin-block: 2.5em 2.2em;
    padding-block: 26px;
    border-block: 2px solid #161d26;
    border-bottom-width: 1px;
    border-bottom-color: #e6e2da;
    color: #161d26;
    font-size: clamp(22px, 3vw, 29px);
    font-weight: 300;
    letter-spacing: -0.018em;
    line-height: 1.28;
  }
  .article-body blockquote p { max-width: none; }
  .article-quote-mask { overflow: hidden; }
  .article-end { position: relative; height: 1px; margin-top: 2.6em; background: #e6e2da; }
  .article-end::after {
    content: '';
    position: absolute;
    top: -4px;
    left: 0;
    width: 26px;
    height: 9px;
    background: var(--c-navy);
    transform-origin: left;
  }
  .article-paper__tail { padding-block: 2.375rem 3.375rem; }
  .article-backlink {
    display: inline-flex;
    align-items: center;
    gap: 0.625rem;
    color: var(--c-graphite);
    font-size: 13px;
    font-weight: 650;
    letter-spacing: 0.12em;
    text-transform: uppercase;
  }
  .article-backlink svg { width: 18px; height: 10px; }
  .article-backlink:hover { gap: 0.94rem; color: var(--c-plum); text-decoration: none; }

  .article-rail {
    position: absolute;
    z-index: 3;
    top: 8rem;
    bottom: 0;
    left: calc(50% - 35.375rem);
    display: none;
    width: 3.5rem;
  }
  .article-rail__inner {
    position: sticky;
    top: 7.5rem;
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 0.75rem;
  }
  .article-rail__label {
    margin-bottom: 0.25rem;
    color: #8a9099;
    font-size: 9.5px;
    font-weight: var(--weight-bold);
    letter-spacing: 0.2em;
    text-transform: uppercase;
    writing-mode: vertical-rl;
  }
  .article-rail button,
  .article-rail a {
    display: grid;
    width: 38px;
    height: 38px;
    padding: 0;
    place-items: center;
    border: 1px solid var(--line);
    border-radius: 50%;
    background: transparent;
    color: #8a9099;
    cursor: pointer;
  }
  .article-rail button:hover,
  .article-rail a:hover { border-color: var(--c-plum); background: var(--c-ivory); color: var(--c-plum); }
  .article-rail svg { width: 15px; height: 15px; }

  .more-writing { padding-block: 4.375rem 4.875rem; border-top: 1px solid #cfc9bc; background: var(--c-stone); }
  .more-writing__head {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    justify-content: space-between;
    gap: 1rem;
    padding-bottom: 0.75rem;
    border-bottom: 2px solid var(--c-navy);
  }
  .more-writing__head h2 { font-family: var(--font-serif); font-size: 26px; font-weight: var(--weight-semi); letter-spacing: -0.015em; }
  .more-writing__head a { color: var(--c-plum); font-size: 12px; font-weight: 650; letter-spacing: 0.14em; text-transform: uppercase; }
  .more-writing__grid { display: grid; grid-template-columns: repeat(var(--related-count), minmax(0, 1fr)); }
  .more-writing__item { padding: 1.625rem 1.875rem 1.625rem 0; border-right: 1px solid #cfc9bc; }
  .more-writing__item:not(:first-child) { padding-left: 1.875rem; }
  .more-writing__item:last-child { border-right: 0; }
  .more-writing__item > p:first-child { color: var(--c-plum); font-size: 11px; font-weight: var(--weight-bold); letter-spacing: 0.14em; text-transform: uppercase; }
  .more-writing__item h3 { margin-top: 0.56rem; font-family: var(--font-serif); font-size: 20px; font-weight: var(--weight-semi); line-height: 1.28; }
  .more-writing__item h3 a { color: var(--c-navy); background: linear-gradient(var(--c-plum), var(--c-plum)) 0 100% / 0 1.5px no-repeat; }
  .more-writing__item > p:nth-of-type(2) { margin-top: 0.5rem; color: var(--c-graphite); font-family: var(--font-serif); font-size: 15px; font-style: italic; }
  .more-writing__item time { display: block; margin-top: 0.7rem; color: var(--c-graphite); font-size: 11px; font-weight: var(--weight-semi); letter-spacing: 0.13em; text-transform: uppercase; }
  .more-writing__item:hover { transform: translateY(-3px); }
  .more-writing__item:hover h3 a { color: var(--c-plum); background-size: 100% 1.5px; text-decoration: none; }

  .article-toast {
    position: fixed;
    z-index: 210;
    bottom: 1.625rem;
    left: 50%;
    padding: 0.7rem 1.25rem;
    border-radius: 999px;
    background: var(--c-navy);
    color: var(--on-dark);
    font-size: 13px;
    font-weight: var(--weight-semi);
    opacity: 0;
    pointer-events: none;
    transform: translate(-50%, 14px);
  }
  .article-toast.is-visible { opacity: 1; transform: translate(-50%, 0); }

  @media (prefers-reduced-motion: no-preference) {
    html.js.article-motion .article-paper { opacity: 0; transform: translateY(20px); transition: opacity 820ms var(--ease), transform 820ms var(--ease); }
    html.js.article-motion .article-paper.is-ready { opacity: 1; transform: none; }
    html.js.article-reveals .article-reveal { opacity: 0; transform: translateY(20px); transition: opacity 700ms var(--ease) var(--reveal-delay, 0ms), transform 700ms var(--ease) var(--reveal-delay, 0ms); }
    html.js.article-reveals .article-reveal.is-visible { opacity: 1; transform: none; }
    html.js.article-reveals .article-body > h2.article-reveal::after { transform: scaleX(0); transition: transform 820ms var(--ease) 90ms; }
    html.js.article-reveals .article-body > h2.article-reveal.is-visible::after { transform: scaleX(1); }
    html.js.article-reveals .article-quote-mask blockquote { transform: translateY(105%); transition: transform 900ms var(--ease) 120ms; }
    html.js.article-reveals .article-quote-mask.is-visible blockquote { transform: none; }
    html.js.article-reveals .article-end.article-reveal::after { transform: scaleX(0); transition: transform 560ms var(--ease) 140ms; }
    html.js.article-reveals .article-end.article-reveal.is-visible::after { transform: scaleX(1); }
    .article-rail { opacity: 0; transition: opacity 420ms var(--ease); }
    .article-rail.is-visible { opacity: 1; }
    .article-pill,
    .article-backlink,
    .article-rail button,
    .article-rail a,
    .more-writing__item,
    .more-writing__item h3 a,
    .article-toast { transition: all 240ms var(--ease); }
    .article-shelf__wash,
    .article-shelf__lines,
    .site-footer__wordmark { will-change: transform; }
  }

  @media (min-width: 77.5rem) {
    .article-rail { display: block; }
  }
  @media (max-width: 62.5rem) {
    .article-stage { margin-top: -4.5rem; }
    .article-paper { max-width: none; border-top: 1px solid #e6e2da; box-shadow: none; }
  }
  @media (max-width: 51.25rem) {
    .article-shelf { padding-block: 5.75rem 6rem; }
    .article-paper { padding-top: 2.75rem; }
    .article-column { padding-inline: 1.625rem; }
    .article-body { padding-top: 2rem; font-size: 18.5px; }
    .more-writing__grid { grid-template-columns: 1fr; }
    .more-writing__item,
    .more-writing__item:not(:first-child) { padding: 1.375rem 0; border-right: 0; border-bottom: 1px solid #cfc9bc; }
    .more-writing__item:last-child { border-bottom: 0; }
  }
  @media (max-width: 37.5rem) {
    .article-shelf__row { align-items: flex-start; }
    .article-byline { align-items: flex-start; }
    .article-byline__actions { width: 100%; }
    .article-pill { padding-inline: 0.7rem; font-size: 10.5px; }
  }
  @media print {
    .site-header,
    .article-progress,
    .article-shelf,
    .article-rail,
    .article-byline__actions,
    .article-paper__tail,
    .more-writing,
    .site-footer,
    .article-toast { display: none !important; }
    .article-stage { margin: 0; }
    .article-paper { box-shadow: none; }
  }
</style>

<script>
  const motionPreference = window.matchMedia('(prefers-reduced-motion: no-preference)');
  const root = document.documentElement;
  const header = document.querySelector<HTMLElement>('.site-header');
  const article = document.querySelector<HTMLElement>('[data-article-paper]');
  const articleBody = document.querySelector<HTMLElement>('[data-article-body]');
  const progress = document.querySelector<HTMLElement>('[data-article-progress]');
  const rail = document.querySelector<HTMLElement>('[data-article-rail]');
  const shelfWash = document.querySelector<HTMLElement>('[data-shelf-wash]');
  const shelfLines = document.querySelector<HTMLElement>('[data-shelf-lines]');
  const footerWordmark = document.querySelector<HTMLElement>('.site-footer__wordmark');
  const toast = document.querySelector<HTMLElement>('[data-article-toast]');
  let scrollFrame = 0;
  let toastTimer = 0;

  const proseRevealTargets = articleBody
    ? Array.from(articleBody.children).filter((element) =>
        ['P', 'H2', 'UL', 'OL', 'BLOCKQUOTE'].includes(element.tagName)
      ) as HTMLElement[]
    : [];

  proseRevealTargets.forEach((element, index) => {
    element.classList.add('article-reveal');
    element.style.setProperty('--reveal-delay', `${Math.min(index % 4, 3) * 55}ms`);
  });

  function setupQuoteMasks() {
    articleBody?.querySelectorAll<HTMLElement>(':scope > blockquote').forEach((quote) => {
      const mask = document.createElement('div');
      mask.className = 'article-quote-mask article-reveal';
      const revealDelay = quote.style.getPropertyValue('--reveal-delay');
      if (revealDelay) mask.style.setProperty('--reveal-delay', revealDelay);
      quote.classList.remove('article-reveal');
      quote.style.removeProperty('--reveal-delay');
      quote.before(mask);
      mask.appendChild(quote);
    });
  }

  const canReveal = motionPreference.matches && 'IntersectionObserver' in window;
  if (canReveal) setupQuoteMasks();

  const revealTargets = Array.from(document.querySelectorAll<HTMLElement>('.article-reveal'));
  if (motionPreference.matches) root.classList.add('article-motion');

  if (canReveal) {
    root.classList.add('article-reveals');
    const observer = new IntersectionObserver((entries) => {
      entries.forEach((entry) => {
        if (!entry.isIntersecting) return;
        entry.target.classList.add('is-visible');
        observer.unobserve(entry.target);
      });
    }, { rootMargin: '0px 0px -8% 0px', threshold: 0.06 });
    revealTargets.forEach((element) => observer.observe(element));
  } else {
    revealTargets.forEach((element) => element.classList.add('is-visible'));
  }

  if (article) {
    requestAnimationFrame(() => requestAnimationFrame(() => article.classList.add('is-ready')));
  }

  function updateArticleScroll() {
    scrollFrame = 0;
    const scrollY = window.scrollY;
    const viewport = Math.max(window.innerHeight, 1);

    header?.setAttribute('data-scrolled', String(scrollY > 40));
    rail?.classList.toggle('is-visible', scrollY > 150);

    if (article && progress && motionPreference.matches) {
      const rect = article.getBoundingClientRect();
      const total = Math.max(rect.height - viewport, 1);
      const completed = Math.max(0, Math.min(total, -rect.top));
      const ratio = rect.bottom <= viewport + 1 ? 1 : completed / total;
      root.style.setProperty('--article-progress', ratio.toFixed(5));
    } else {
      root.style.removeProperty('--article-progress');
    }

    if (!motionPreference.matches) return;

    shelfWash?.style.setProperty('--shelf-wash-shift', `${(scrollY * 0.055).toFixed(1)}px`);
    shelfLines?.style.setProperty('--shelf-lines-shift', `${(scrollY * 0.1).toFixed(1)}px`);

    if (footerWordmark) {
      const footerRect = footerWordmark.getBoundingClientRect();
      if (footerRect.top < viewport && footerRect.bottom > 0) {
        const shift = Math.min(22, Math.max(-22, (viewport - footerRect.top) * -0.045));
        footerWordmark.style.transform = `translate3d(0, calc(18% + ${shift.toFixed(1)}px), 0)`;
      }
    }
  }

  function requestArticleScrollUpdate() {
    if (!scrollFrame) scrollFrame = requestAnimationFrame(updateArticleScroll);
  }

  window.addEventListener('scroll', requestArticleScrollUpdate, { passive: true });
  window.addEventListener('resize', requestArticleScrollUpdate, { passive: true });
  motionPreference.addEventListener?.('change', () => window.location.reload());
  requestArticleScrollUpdate();

  function showToast(message: string) {
    if (!toast) return;
    toast.textContent = message;
    toast.classList.add('is-visible');
    window.clearTimeout(toastTimer);
    toastTimer = window.setTimeout(() => toast.classList.remove('is-visible'), 1900);
  }

  document.querySelectorAll<HTMLButtonElement>('[data-copy-link]').forEach((button) => {
    button.addEventListener('click', async () => {
      try {
        await navigator.clipboard.writeText(window.location.href);
        showToast('Link copied');
      } catch {
        showToast('Could not copy');
      }
    });
  });
  document.querySelector<HTMLButtonElement>('[data-print-article]')?.addEventListener('click', () => window.print());
</script>
