# Contact form delivery (api/contact.js).
# Set the REAL values in Vercel → Project → Settings → Environment Variables
# for the Production and Preview environments. Do NOT put real values in the repo.
#
# Variable names only — no secrets here.

# Resend API key (transactional email). Create at https://resend.com → API Keys.
RESEND_API_KEY=

# Private destination inbox that contact submissions are delivered to.
CONTACT_TO_EMAIL=

# Optional Resend timeout override in milliseconds (default: 8000).
CONTACT_RESEND_TIMEOUT_MS=

# Note: the GA4 measurement ID and the verified sender address
# (contact@fuquainc.com) are non-secret and configured in source, not here.
